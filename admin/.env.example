# URL pública del backend de VendoX.
#
# NEXT_PUBLIC_ significa que viaja al navegador: acá va SÓLO la URL de la API.
# Nunca un token de Mercado Pago, la cadena de la base, credenciales de R2 ni
# el secreto de LiveKit. Todo eso vive en el backend y no tiene por qué salir.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
