# =============================================================================
# SPRINT 0 — Variables de entorno del backend
#
# Copiar a `.env` para desarrollo local:   cp .env.example .env
# NUNCA commitear `.env`. En staging/producción se usan Fly Secrets.
#
# La app NO ARRANCA si falta alguna variable obligatoria: `src/config/env.schema.ts`
# valida con Zod al inicio y mata el proceso con un mensaje claro.
#
# ⛔ Este archivo SÍ se versiona. Va con valores de ejemplo, nunca con claves
#    reales. Ya pasó una vez: se pegaron acá las credenciales de LiveKit.
# =============================================================================

# ─── Aplicación ───────────────────────────────────────────────────────────────
NODE_ENV=development                # development | test | staging | production
PORT=3000
LOG_LEVEL=debug                     # trace|debug|info|warn|error|fatal
TZ=UTC                              # la base SIEMPRE en UTC. es-AR solo en presentación.
GIT_SHA=local                       # lo inyecta CI; aparece en logs y en /health

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Local (docker compose). El puerto es 5433 y no 5432 para no chocar con otro
# proyecto que ya ocupa el estándar en esta máquina.
DATABASE_URL=postgresql://livesell:livesell@localhost:5433/livesell?schema=public
# Staging/Prod (Neon, São Paulo). pgbouncer=true es OBLIGATORIO con pooling en
# modo transaction: sin él Prisma usa prepared statements y produce errores
# intermitentes imposibles de reproducir en desarrollo.
# DATABASE_URL=postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/livesell?sslmode=require&pgbouncer=true&connect_timeout=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380
# Staging/Prod (Upstash, São Paulo):
# REDIS_URL=rediss://default:pass@xxx.upstash.io:6379

# ─── LiveKit Cloud ────────────────────────────────────────────────────────────
# Se obtienen en https://cloud.livekit.io → Settings → Keys
# ⚠️ El API_SECRET NUNCA sale del backend. La app Flutter recibe solo tokens firmados.
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=reemplazar-por-el-secreto-del-panel
LIVEKIT_WS_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_HTTP_URL=https://tu-proyecto.livekit.cloud
LIVEKIT_WEBHOOK_ENABLED=true

# TTL de los tokens. Broadcaster largo (una transmisión puede durar horas),
# viewer más corto (se re-emite al reentrar).
LIVEKIT_BROADCASTER_TOKEN_TTL_S=21600     # 6 h
LIVEKIT_VIEWER_TOKEN_TTL_S=7200           # 2 h

# ─── Spike (Sprint 0) ─────────────────────────────────────────────────────────
# El módulo de spike NO tiene autenticación de usuarios (Auth no existe todavía).
# Se protege con una clave compartida en el header `x-spike-key`.
# Generar con: openssl rand -hex 32
SPIKE_API_KEY=cambiame-por-una-clave-larga-y-aleatoria
# Interruptor maestro: en producción debe quedar en false y el módulo no se carga.
SPIKE_ENABLED=true

# ─── Mercado Pago (Sprint 0B) ─────────────────────────────────────────────────
# Panel: https://www.mercadopago.com.ar/developers/panel
#
# ⚠️ Fuera de production el ACCESS_TOKEN debe empezar con `TEST-`. env.schema.ts
#    lo verifica y no deja arrancar: con un token productivo, cada prueba le
#    cobraría de verdad a alguien.
#
# El ACCESS_TOKEN nunca sale del backend. La PUBLIC_KEY sí viaja al teléfono:
# es su función, sólo sirve para crear tokens de tarjeta de un solo uso.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# Webhooks → Configurar notificación → "clave secreta". Firma cada aviso.
MP_WEBHOOK_SECRET=reemplazar-por-la-clave-secreta-del-panel
# URL pública que recibe las notificaciones. En el spike, el túnel de Cloudflare.
MP_NOTIFICATION_URL=https://tu-tunel.trycloudflare.com/webhooks/orders/mercadopago
MP_API_BASE_URL=https://api.mercadopago.com
MP_TIMEOUT_MS=10000
# Interruptor maestro. Igual que SPIKE_ENABLED: en producción debe ser false.
PAYMENTS_SPIKE_ENABLED=false

# ─── Observabilidad ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
METRICS_ENABLED=true

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Clave de firma de los access tokens. Generar con: openssl rand -base64 48
# ⚠️ Cambiarla desloguea a todo el mundo: los tokens en circulación dejan de
#    validar. Es exactamente lo que se quiere ante una filtración.
JWT_SECRET=generar-con-openssl-rand-base64-48
JWT_ACCESS_TTL_S=900          # 15 min. Corto porque el access token no se revoca.
JWT_REFRESH_TTL_S=2592000     # 30 días sin abrir la app antes de reloguear.

# Client IDs de Google. Sirven para validar que el token de identidad fue
# emitido PARA NUESTRA APP: sin esa comprobación, un token de cualquier otra
# aplicación de Google serviría para entrar acá.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
APPLE_BUNDLE_ID=

# Login sin proveedor externo, para desarrollo. Prohibido en producción.
AUTH_DEV_LOGIN_ENABLED=false

# ─── Inventario ─────────────────────────────────────────────────────────────
# Cuánto dura una reserva de stock. Cinco minutos: alcanza para completar un
# pago con conexión mala, y es poco como para que un carrito abandonado bloquee
# la última unidad durante un vivo.
INVENTORY_RESERVATION_TTL_SECONDS=300

# Tope de unidades por reserva. Sin él, una sola petición puede apartar el
# catálogo entero de un vendedor durante todo el TTL.
INVENTORY_MAX_QUANTITY_PER_RESERVATION=10

# A partir de cuántas unidades disponibles se muestra "quedan pocas".
INVENTORY_LOW_STOCK_THRESHOLD=3

# Red de seguridad: cada cuánto se barren las reservas vencidas.
# La precisión la da el job diferido de BullMQ; esto garantiza que igual pase
# aunque Redis se reinicie y se pierdan los jobs.
INVENTORY_RECONCILER_INTERVAL_MS=30000
INVENTORY_RECONCILER_ENABLED=true

# Jobs diferidos para vencer al segundo exacto.
# Apagarlo NO impide vender: la reserva se crea igual y el reconciliador la
# vence. Redis es precisión, nunca una dependencia transaccional.
INVENTORY_EXPIRATION_QUEUE_ENABLED=true

# ─── Imágenes ────────────────────────────────────────────────────────────────

# local | r2
#
# En desarrollo, `local`: las imágenes van a ./storage y se sirven por /media.
# No hace falta ninguna credencial de Cloudflare para trabajar ni para correr
# los tests.
#
# Para reproducir un problema de staging contra R2 de verdad, se pone `r2` y se
# completan las cuatro variables de abajo. El resto del código no cambia.
STORAGE_DRIVER=local

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_S=300

# =============================================================================
# INTERRUPTORES DE EMERGENCIA
# =============================================================================
#
# Cuatro llaves de luz para apagar una parte del sistema sin desplegar nada.
# El caso que las justifica es siempre urgente:
#
#   CHECKOUT_ENABLED=false       Mercado Pago devuelve pagos duplicados
#   LIVE_ENABLED=false           LiveKit caido: cada vivo es una sala que no conecta
#   PRODUCT_UPLOAD_ENABLED=false alguien sube ejecutables disfrazados de imagen
#   SELLER_SIGNUP_ENABLED=false  campana de cuentas falsas abriendo tiendas
#
# Encendidas por omision: una bandera que hay que acordarse de prender para que
# el sistema funcione es un sistema apagado esperando a que alguien se olvide.
#
# Apagar una NO rompe lo que ya esta en curso. Los pedidos pagos se preparan y
# se entregan igual, el vivo al aire sigue, los productos publicados se venden.
# Cierran la puerta de entrada y nada mas. Ver src/shared/config/banderas.ts
#
# Cambiarlas exige reiniciar el proceso.
LIVE_ENABLED=true
CHECKOUT_ENABLED=true
SELLER_SIGNUP_ENABLED=true
PRODUCT_UPLOAD_ENABLED=true

# ─── Enlaces que abren la app (Android App Links) ─────────────────────────────
#
# Las huellas SHA-256 de las claves que firman la APK, separadas por coma.
# Alimentan /.well-known/assetlinks.json, que es lo que Android lee para
# decidir si un enlace de vendox.com.ar abre la app o el navegador.
#
# NO son secretos: el archivo que las publica es público por diseño. Están acá
# con su valor real a propósito — un marcador de posición invita a un error de
# tipeo, y una huella mal escrita produce un assetlinks que Android rechaza en
# silencio, sin un solo error en ningún log.
#
# Van DOS, y el orden no importa:
#
#   1ª · Play App Signing — la clave con la que Google re-firma el AAB. Es la
#        que cuenta para todo el que descarga la app de la tienda.
#   2ª · La clave de subida — la que tenés vos. Sólo sirve para que la build
#        local también abra los enlaces mientras probás.
#
# Con una sola, los enlaces funcionan en un teléfono y en el resto no. Es el
# error más común de esta configuración.
#
# Las dos están cargadas. Si algún día se rota la clave de subida, se saca la
# nueva con:
#      keytool -list -v -keystore vendox-upload.jks -alias vendox-upload
ANDROID_CERT_SHA256=66:03:89:1D:04:BB:9C:C1:9A:4D:84:89:31:1A:4E:3A:B3:D4:43:90:ED:11:B8:CE:DA:51:DB:00:21:48:8B:2F,D4:CC:12:F7:B1:CE:B0:CB:FC:4A:D2:FB:D7:5C:73:CB:66:C9:75:38:27:2B:F3:0F:CC:F8:A7:F2:9D:0C:9F:30
