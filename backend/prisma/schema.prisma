// =============================================================================
// SPRINT 0 — Esquema mínimo.
//
// Solo las tablas necesarias para instrumentar los spikes de LiveKit y
// Mercado Pago. Son ADITIVAS: no chocan con el esquema completo de
// db/schema.prisma, que se incorpora recién cuando arranque el módulo Auth.
//
// Convenciones (blueprint/05-datos-postgres.md):
//   · IDs = ULID con prefijo, en TEXT.
//   · Tiempo = DateTime en UTC, siempre.
//   · Métricas numéricas = Int en milisegundos. Nada de Float para tiempos.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // La que usa la aplicación. Con Neon, la del pooler.
  url = env("DATABASE_URL")

  // ───────────────────────────────────────────────────────────────────────────
  // La conexión DIRECTA, que usan sólo las migraciones.
  //
  // `prisma migrate deploy` toma un lock de sesión y ejecuta DDL. PgBouncer en
  // modo transacción no sostiene ninguna de las dos cosas: no hay sesión que
  // persista entre sentencias. La migración se cuelga esperando el lock, o —
  // peor— queda aplicada a medias, que es un estado del que no se sale solo.
  //
  // Prisma sabe usar ésta para migrar y la otra para consultar. Sin declararlo
  // acá, migrar contra el pooler es el comportamiento por omisión.
  //
  // En local no hay pooler y `DIRECT_URL` no está definida; el `.env` la deja
  // apuntando a la misma base y no cambia nada.
  // ───────────────────────────────────────────────────────────────────────────
  directUrl = env("DIRECT_URL")
}

enum SpikeRole {
  BROADCASTER
  VIEWER

  @@map("spike_role")
}

enum NetworkType {
  WIFI
  CELLULAR_5G
  CELLULAR_4G
  CELLULAR_3G
  UNKNOWN

  @@map("network_type")
}

enum SpikeEventType {
  SESSION_START
  ROOM_CONNECTING
  ROOM_CONNECTED
  ROOM_RECONNECTING
  ROOM_RECONNECTED
  ROOM_DISCONNECTED
  TRACK_PUBLISHED
  TRACK_SUBSCRIBED
  TRACK_UNSUBSCRIBED
  FIRST_FRAME
  NETWORK_CHANGED
  QUALITY_CHANGED
  ERROR
  SESSION_END

  @@map("spike_event_type")
}

/// Una corrida del spike: un par broadcaster/viewer probando en una condición
/// concreta (operadora, tipo de red, ubicación).
model SpikeSession {
  id       String @id // spk_<ulid>
  label    String // "Personal 4G · Palermo · tarde"
  roomName String @unique @map("room_name") // sala en LiveKit

  /// Condiciones de la prueba. Sin esto los números no significan nada:
  /// "800 ms" es excelente en 3G y malo en fibra.
  carrier      String?
  networkType  NetworkType @default(UNKNOWN) @map("network_type")
  locationNote String?     @map("location_note")

  broadcasterDevice Json? @map("broadcaster_device")
  viewerDevice      Json? @map("viewer_device")

  notes     String?
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  samples      SpikeSample[]
  events       SpikeEvent[]
  measurements GlassToGlassMeasurement[]

  @@index([startedAt])
  @@map("spike_sessions")
}

/// Muestra periódica de calidad. El broadcaster y el viewer envían una por
/// segundo, en lotes de 10 para no generar una petición por segundo por device.
model SpikeSample {
  id        String    @id
  sessionId String    @map("session_id")
  role      SpikeRole
  seq       Int
  /// Instante de la muestra en el reloj DEL SERVIDOR, ya corregido por el
  /// offset que el cliente calculó con /spike/time. Sin esta corrección,
  /// comparar timestamps entre dos teléfonos distintos no significa nada.
  at        DateTime

  /// Latencia one-way del canal de datos: el broadcaster publica un paquete
  /// con su reloj corregido y el viewer resta. Es un PISO de la latencia de
  /// video, no la latencia de video: el data channel se salta encode,
  /// jitter buffer, decode y render.
  probeLatencyMs Int? @map("probe_latency_ms")

  /// Estimación de glass-to-glass calculada por el backend a partir de la
  /// muestra. Se CALIBRA contra las mediciones manuales (ver §calibración).
  estimatedE2eMs Int? @map("estimated_e2e_ms")

  // ─── Estadísticas de WebRTC ───
  rttMs               Int?    @map("rtt_ms")
  jitterMs            Int?    @map("jitter_ms")
  packetsLost         Int?    @map("packets_lost")
  packetLossPct       Float?  @map("packet_loss_pct")
  jitterBufferDelayMs Int?    @map("jitter_buffer_delay_ms")
  framesDecoded       Int?    @map("frames_decoded")
  framesDropped       Int?    @map("frames_dropped")
  freezeCount         Int?    @map("freeze_count")
  bitrateKbps         Int?    @map("bitrate_kbps")
  fps                 Float?
  frameWidth          Int?    @map("frame_width")
  frameHeight         Int?    @map("frame_height")
  /// Capa de simulcast que está recibiendo: valida que el ABR funciona.
  videoLayer          String? @map("video_layer")

  connectionQuality String?     @map("connection_quality") // excellent|good|poor|lost
  networkType       NetworkType @default(UNKNOWN) @map("network_type")
  carrier           String?
  clockOffsetMs     Int?        @map("clock_offset_ms")

  createdAt DateTime @default(now()) @map("created_at")

  session SpikeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, role, at])
  @@map("spike_samples")
}

/// Eventos discretos del ciclo de vida. Miden lo que las muestras periódicas
/// no ven: cuánto tarda en conectar, cuánto en reconectar, cuándo llega el
/// primer frame.
model SpikeEvent {
  id         String         @id
  sessionId  String         @map("session_id")
  role       SpikeRole
  type       SpikeEventType
  at         DateTime
  /// Milisegundos desde el evento anterior relevante. Para ROOM_RECONNECTED
  /// es el tiempo de reconexión; para FIRST_FRAME, el time-to-first-frame.
  durationMs Int?           @map("duration_ms")
  detail     Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  session SpikeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([type])
  @@map("spike_events")
}

/// Medición MANUAL de glass-to-glass: la referencia de verdad.
/// Método en docs/sprint-0/RUNBOOK-livekit.md §5.
model GlassToGlassMeasurement {
  id        String @id
  sessionId String @map("session_id")

  /// Lo que se lee en la foto: reloj del overlay menos reloj dentro del video.
  latencyMs            Int  @map("latency_ms")
  /// Muestra automática más cercana en el tiempo. Permite calcular el sesgo
  /// entre la estimación y la realidad, y calibrar.
  pairedEstimatedE2eMs Int? @map("paired_estimated_e2e_ms")

  method      String      @default("overlay_photo")
  networkType NetworkType @default(UNKNOWN) @map("network_type")
  carrier     String?
  photoRef    String?     @map("photo_ref")
  note        String?
  measuredAt  DateTime    @default(now()) @map("measured_at")

  session SpikeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("glass_to_glass_measurements")
}

/// Webhooks de LiveKit. Mismo patrón que usaremos con Mercado Pago:
/// UNIQUE sobre el id del evento del proveedor = deduplicación garantizada
/// por la base, no por el código.
model LivekitWebhookEvent {
  id             String    @id
  eventId        String    @map("event_id")
  event          String
  roomName       String?   @map("room_name")
  participantId  String?   @map("participant_id")
  payload        Json
  signatureValid Boolean   @map("signature_valid")
  processedAt    DateTime? @map("processed_at")
  error          String?
  receivedAt     DateTime  @default(now()) @map("received_at")

  @@unique([eventId])
  @@index([roomName, receivedAt])
  @@map("livekit_webhook_events")
}

// =============================================================================
// SPRINT 0B — Spike de Mercado Pago
//
// Riesgo R1: ¿se puede cobrar con tarjeta desde Flutter sin arrastrar el
// alcance PCI completo, y sobrevive el flujo a webhooks duplicados, perdidos,
// desordenados y falsificados?
//
// REGLA QUE GOBIERNA TODO EL MÓDULO
// ---------------------------------
// El webhook NO es la fuente de verdad. Es un "andá a fijarte". El estado
// siempre se toma consultando la API de Mercado Pago con nuestro access token.
// Un webhook falsificado, entonces, no puede acreditar un pago aunque logre
// pasar la firma: lo único que consigue es que le preguntemos a Mercado Pago,
// que va a responder la verdad.
//
// Corolario: NADA de datos de tarjeta acá. Ni PAN, ni CVV, ni el token de la
// tarjeta. Sólo los últimos cuatro dígitos y la marca, que es lo que PCI
// permite guardar y lo único que la interfaz necesita mostrar.
// =============================================================================

enum PayOrderStatus {
  /// Creada, todavía sin intento de cobro.
  PENDING_PAYMENT
  /// Hay un pago en curso. Estado deliberadamente pegajoso: ante cualquier
  /// duda se queda acá, nunca se pasa a FAILED por un timeout de red.
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED

  @@map("pay_order_status")
}

/// Espejo de los estados de Mercado Pago. Se replican con sus nombres para que
/// traducir no pueda introducir un error de interpretación.
enum PayPaymentStatus {
  PENDING
  IN_PROCESS
  AUTHORIZED
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
  UNKNOWN

  @@map("pay_payment_status")
}

/// Quién produjo un cambio de estado. Sin esto, ante una discrepancia no hay
/// forma de saber si fue la app, un webhook o el conciliador.
enum PaySource {
  API
  WEBHOOK
  RECONCILER
  MANUAL

  @@map("pay_source")
}

/// Orden de compra del spike. Un producto, una unidad: alcanza para responder
/// la pregunta de si podemos cobrar.
model SpikeOrder {
  id String @id // ord_<ulid>

  /// Clave de idempotencia que manda el cliente. UNIQUE en la base: dos toques
  /// del botón "Pagar" con la misma clave no pueden crear dos órdenes ni
  /// aunque lleguen en paralelo. La garantía es del motor, no del código.
  idempotencyKey String @unique @map("idempotency_key")

  buyerEmail  String @map("buyer_email")
  description String

  /// Centavos. Nunca Float para dinero: 0.1 + 0.2 no es 0.3 en binario.
  amountCents Int    @map("amount_cents")
  currency    String @default("ARS")

  status PayOrderStatus @default(PENDING_PAYMENT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  paidAt    DateTime? @map("paid_at")

  payments SpikePayment[]
  events   SpikePaymentEvent[]

  @@index([status, createdAt])
  @@map("spike_orders")
}

/// Intento de cobro contra Mercado Pago. Una orden puede tener varios: el
/// primero rechazado por fondos, el segundo aprobado.
model SpikePayment {
  id      String @id // pay_<ulid>
  orderId String @map("order_id")

  /// Id del pago en Mercado Pago. UNIQUE: es lo que impide acreditar dos veces
  /// el mismo pago cuando llegan webhooks repetidos.
  mpPaymentId String? @unique @map("mp_payment_id")

  status       PayPaymentStatus @default(PENDING)
  /// `cc_rejected_insufficient_amount`, `accredited`, etc. Es lo que permite
  /// darle al comprador un mensaje útil en vez de "error".
  statusDetail String?          @map("status_detail")

  amountCents     Int     @map("amount_cents")
  installments    Int     @default(1)
  paymentMethodId String? @map("payment_method_id")
  paymentTypeId   String? @map("payment_type_id")

  /// Lo ÚNICO que se guarda de la tarjeta. PCI permite los últimos cuatro
  /// dígitos y la marca; nada más entra a esta base.
  cardLastFour String? @map("card_last_four")
  cardBrand    String? @map("card_brand")

  /// Respuesta de Mercado Pago con los campos sensibles removidos.
  /// El saneado ocurre ANTES de escribir, en `scrubMpPayment()`.
  rawResponse Json? @map("raw_response")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order SpikeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status])
  @@map("spike_payments")
}

/// Bitácora de auditoría de pagos. Append-only: no se actualiza ni se borra.
/// Es la respuesta a "¿por qué esta orden figura pagada?" seis meses después.
model SpikePaymentEvent {
  id      String @id // pev_<ulid>
  orderId String @map("order_id")

  source PaySource
  /// `order.created`, `payment.created`, `payment.status_changed`,
  /// `webhook.received`, `webhook.rejected`, `reconciler.fixed`.
  kind   String

  fromStatus String? @map("from_status")
  toStatus   String? @map("to_status")

  detail Json?
  at     DateTime @default(now())

  order SpikeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("spike_payment_events")
}

/// Notificaciones recibidas de Mercado Pago, válidas y rechazadas por igual.
///
/// Las rechazadas se guardan a propósito: un pico de firmas inválidas es la
/// señal de que alguien está probando el endpoint, y sin registro no se ve.
model MpWebhookEvent {
  id String @id // mpw_<ulid>

  /// Id de la notificación según Mercado Pago. UNIQUE = deduplicación por
  /// motor de base de datos. El reintento de Mercado Pago choca contra el
  /// índice y no llega a ejecutar la lógica.
  notificationId String @unique @map("notification_id")

  topic      String
  action     String?
  /// `data.id`: el id del pago que hay que ir a consultar.
  resourceId String? @map("resource_id")

  signatureValid  Boolean @map("signature_valid")
  /// Motivo del rechazo cuando la firma no valida. Sin esto, depurar en
  /// producción es adivinar.
  rejectionReason String? @map("rejection_reason")

  headers Json
  payload Json

  processedAt DateTime? @map("processed_at")
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@index([resourceId, receivedAt])
  @@index([signatureValid, receivedAt])
  @@map("mp_webhook_events")
}

/// Comprador con medio de pago guardado. Es lo que habilita la segunda compra
/// en dos clics, que es el objetivo de producto del spike.
///
/// La tarjeta vive en Mercado Pago. Acá sólo se guarda la referencia.
model SpikeCustomer {
  id           String @id // cus_<ulid>
  email        String @unique
  mpCustomerId String @unique @map("mp_customer_id")

  createdAt DateTime @default(now()) @map("created_at")

  cards SpikeCustomerCard[]

  @@map("spike_customers")
}

model SpikeCustomerCard {
  id         String @id // crd_<ulid>
  customerId String @map("customer_id")

  /// Referencia opaca de Mercado Pago. Para cobrar se pide un token nuevo a
  /// partir de este id más el CVV; la tarjeta nunca pasa por nuestro backend.
  mpCardId String @unique @map("mp_card_id")

  lastFour        String  @map("last_four")
  brand           String?
  expirationMonth Int?    @map("expiration_month")
  expirationYear  Int?    @map("expiration_year")

  createdAt DateTime @default(now()) @map("created_at")

  customer SpikeCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("spike_customer_cards")
}

// =============================================================================
// AUTH — primer módulo de producto
//
// Diseñado a partir de db/schema.prisma (el esquema completo de referencia),
// con dos desviaciones deliberadas que se explican en su lugar:
//   · las identidades de proveedor viven en su propia tabla;
//   · el teléfono es opcional al registrarse.
//
// Principio que gobierna el módulo: la sesión se tiene que poder cortar en
// cualquier momento, desde el servidor, y sin desloguear a los demás
// dispositivos. Todo lo demás se deriva de eso.
// =============================================================================

enum AuthProvider {
  google
  apple
  phone

  @@map("auth_provider")
}

enum UserRole {
  buyer
  seller
  moderator
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum DevicePlatform {
  android
  ios

  @@map("device_platform")
}

model User {
  id String @id // usr_<ulid>

  firstName String @map("first_name")
  lastName  String @map("last_name")

  /// Único: una persona, una cuenta. Si entra con Google y después con Apple
  /// devolviendo el mismo email, se vincula a la MISMA cuenta en vez de crear
  /// una segunda. Ver UserIdentity.
  ///
  /// Se guarda siempre en minúscula y sin espacios: sin eso, "Juan@Gmail.com"
  /// y "juan@gmail.com" serían dos cuentas distintas.
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")

  /// ⚠️ Desviación del esquema de referencia: acá es OPCIONAL.
  ///
  /// El registro con Google o Apple no entrega teléfono, y exigirlo rompería
  /// el onboarding ultrarrápido que es un requisito del producto. El teléfono
  /// se pide antes de COMPRAR, no antes de mirar.
  phoneE164     String? @map("phone_e164")
  phoneVerified Boolean @default(false) @map("phone_verified")
  whatsappOptIn Boolean @default(true) @map("whatsapp_opt_in")

  avatarUrl String? @map("avatar_url")

  role   UserRole   @default(buyer)
  status UserStatus @default(active)

  locale   String @default("es-AR")
  timezone String @default("America/Argentina/Buenos_Aires")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Borrado lógico: una cuenta con órdenes no se puede borrar de verdad sin
  /// romper el historial de compras y la contabilidad.
  deletedAt  DateTime? @map("deleted_at")

  identities    UserIdentity[]
  devices       Device[]
  refreshTokens RefreshToken[]
  seller        Seller?
  addresses     UserAddress[]
  orders        Order[]
  follows       Follow[]
  reviews       Review[]
  intents       PurchaseIntent[]
  notifications Notification[]
  supportTickets SupportTicket[]
  likes          Like[]

  @@index([phoneE164])
  @@index([status, createdAt])
  @@map("users")
}

/// Identidad en un proveedor externo.
///
/// ⚠️ Desviación del esquema de referencia, que guardaba authProvider y
/// providerSub directamente en User.
///
/// El motivo: con un solo par de campos, una persona que entró con Google y un
/// día toca "Continuar con Apple" no puede iniciar sesión. O se le crea una
/// cuenta duplicada —con su historial de compras partido en dos— o se le niega
/// el acceso. Las dos salidas son malas y las dos aparecen recién en
/// producción.
///
/// Una tabla aparte hace que vincular un segundo proveedor sea insertar una
/// fila.
model UserIdentity {
  id     String @id // idn_<ulid>
  userId String @map("user_id")

  provider AuthProvider
  /// El identificador estable del proveedor (sub del token). NO el email: el
  /// email puede cambiar, el sub no.
  subject  String

  email      String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// La llave real de autenticación. Dos personas distintas no pueden
  /// compartir un sub en el mismo proveedor.
  @@unique([provider, subject])
  /// Y una cuenta no puede tener dos identidades del mismo proveedor.
  @@unique([userId, provider])
  @@map("user_identities")
}

model Device {
  id     String @id // dev_<ulid>
  userId String @map("user_id")

  /// Token de push. Único a nivel global: si la persona reinstala la app en
  /// otro teléfono y el sistema recicla el token, tiene que quedar apuntando a
  /// UNA sola cuenta. Sin esta restricción, alguien recibiría notificaciones
  /// de la cuenta de otro.
  pushToken String? @unique @map("push_token")

  platform   DevicePlatform
  appVersion String         @map("app_version")
  osVersion  String         @map("os_version")
  /// Identificador estable del dispositivo que manda la app. Permite reconocer
  /// el mismo teléfono entre reinstalaciones y cerrar su sesión puntualmente.
  installId  String         @unique @map("install_id")
  model      String?

  timezone     String  @default("America/Argentina/Buenos_Aires")
  pushEnabled  Boolean @default(true) @map("push_enabled")
  /// Fallos consecutivos de envío. A partir de cierto número el token se da
  /// por muerto y se deja de intentar, que es lo que pide FCM.
  failureCount Int     @default(0) @map("failure_count") @db.SmallInt

  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

/// Token de refresco.
///
/// ─── Nunca se guarda el token ───
///
/// Sólo su SHA-256. Si alguien lee la base, no se lleva sesiones: se lleva
/// hashes que no sirven para autenticarse. Es el mismo razonamiento que con
/// las contraseñas, y vale igual para los tokens.
///
/// ─── Rotación con detección de reuso ───
///
/// Cada uso emite uno nuevo y marca el anterior como rotado. Si llega un token
/// YA ROTADO, hay dos copias en circulación: alguien lo robó. En ese caso no
/// alcanza con rechazarlo —el ladrón ya tiene el siguiente— hay que revocar
/// toda la familia, que es la cadena entera de rotaciones de esa sesión.
///
/// familyId existe para eso: revocar es un UPDATE por índice, en vez de
/// recorrer la cadena de replacedBy de a un salto por consulta.
model RefreshToken {
  id     String @id // rtk_<ulid>
  userId String @map("user_id")

  /// SHA-256 del token. Jamás el token.
  tokenHash String @unique @map("token_hash")

  /// Todas las rotaciones de una misma sesión comparten familia.
  familyId String @map("family_id")

  deviceId String? @map("device_id")

  /// Id del token que reemplazó a éste. Su presencia significa "ya usado".
  replacedById  String?   @map("replaced_by_id")
  revokedAt     DateTime? @map("revoked_at")
  /// Por qué se revocó. reuse_detected es el que importa vigilar.
  revokedReason String?   @map("revoked_reason")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  /// Contexto de emisión. Sirve para mostrarle a la persona sus sesiones
  /// activas y para investigar un robo.
  ip        String?
  userAgent String? @map("user_agent")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Bitácora de autenticación.
///
/// Append-only. Es lo que permite responder "de dónde entraron a esta cuenta"
/// cuando alguien reporta un acceso indebido, y detectar un ataque de fuerza
/// bruta antes de que funcione.
model AuthEvent {
  id     String  @id // aev_<ulid>
  userId String? @map("user_id")

  /// login.google, login.apple, register, refresh, refresh.reuse, logout,
  /// logout.all, token.rejected.
  kind    String
  success Boolean @default(true)
  /// Motivo del fallo, cuando success es false.
  reason  String?

  ip        String?
  userAgent String? @map("user_agent")
  detail    Json?

  at DateTime @default(now())

  @@index([userId, at])
  @@index([kind, at])
  @@map("auth_events")
}

// =============================================================================
// BLOQUE COMERCIAL — Sellers · Stores · Products · Variants · Images
//
// ─── LA CONVENCIÓN DE DINERO ───
//
// Enteros en CENTAVOS. Nunca Float, nunca Decimal, nunca String.
//
// `$12.500,50` se guarda como `1250050`. Sumar, restar y comparar es exacto,
// que es lo único que importa cuando el número es plata de alguien.
//
// Se eligió `Int` (int4) y no `BigInt` por dos motivos concretos:
//
//   1. Es lo que YA usa el módulo de pagos (`amountCents`). Dos convenciones de
//      dinero en un mismo sistema es cómo aparece un error de 100×.
//   2. `BigInt` en Prisma llega a JavaScript como `BigInt`, que `JSON.stringify`
//      no sabe serializar. Obliga a un serializador propio en Fastify, en los
//      tests y en el parseo de Flutter — tres lugares donde alguien se olvida.
//
// El techo de `Int` es 2.147.483.647 centavos = **$21.474.836,47**. Está muy
// por encima del catálogo de esta app (indumentaria, accesorios, cosmética,
// hogar). El día que deje de alcanzar, migrar int4 → int8 es un ALTER TABLE de
// ensanchamiento: no pierde datos y no reescribe la tabla.
//
// ─── EL PRINCIPIO DE AUTORIZACIÓN ───
//
// Toda la jerarquía cuelga del usuario autenticado:
//
//     User → Seller → Store → Product → Variant/Image
//
// Ningún servicio busca por id y después comprueba el dueño. Busca SIEMPRE
// filtrando por el dueño. Con eso, un IDOR no es un chequeo que alguien pueda
// olvidar: es una consulta que no devuelve la fila.
// =============================================================================

enum SellerStatus {
  /// Creado, todavía sin revisar. Puede preparar su tienda; no puede vender.
  PENDING
  ACTIVE
  /// Suspendido temporalmente por una infracción. Puede volver.
  SUSPENDED
  /// Bloqueado por fraude. No vuelve.
  BLOCKED
  /// Cerrado por decisión propia.
  CLOSED

  @@map("seller_status")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum StoreStatus {
  ACTIVE
  /// De vacaciones. Los productos siguen existiendo pero no se venden.
  PAUSED
  CLOSED

  @@map("store_status")
}

/// Cómo cobra el envío una tienda. V1 manual, sin transportistas.
enum ShippingMode {
  /// El vendedor lo absorbe. El comprador ve "Envío gratis".
  FREE
  /// Un monto fijo, el mismo para todo el país.
  FIXED_PRICE
  /// No hay envío: se retira en persona.
  PICKUP_ONLY
  /// El comprador elige entre pagar el envío o retirar.
  FIXED_OR_PICKUP

  @@map("shipping_mode")
}

/// Quién paga el costo del procesador de pagos.
///
/// El costo es del vendedor por definición del negocio. Esto dice si lo
/// descuenta de lo suyo o lo suma al total del comprador.
///
/// ⚠️ **Trasladarlo tiene un límite legal.** En Argentina hay medios y
/// situaciones donde recargar por pagar con tarjeta no está permitido. La
/// plataforma ofrece la opción; la responsabilidad de usarla donde corresponde
/// es del vendedor, y así se le dice en la pantalla.
enum ProcessorFeeMode {
  /// Lo descuenta de su neto. El comprador paga producto + envío.
  ABSORBED
  /// Se le suma al comprador, cuando el medio lo permite.
  PASSED_TO_BUYER

  @@map("processor_fee_mode")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE
  /// Combinación que el vendedor no comercializa. Se genera pero no se vende.
  INACTIVE

  @@map("variant_status")
}

/// Vendedor.
///
/// Relación 1:1 con `User`. Una persona compra sin ser vendedor; para vender
/// necesita un Seller.
///
/// ─── Regla de dominio para Live Sessions (todavía no implementado) ───
///
/// Un seller en `SUSPENDED` o `BLOCKED` **no puede iniciar una transmisión**.
/// Se comprueba al emitir el token de LiveKit, no en la app: el token es lo
/// único que el servidor controla y lo único que no se puede falsificar.
model Seller {
  id     String @id // sel_<ulid>
  userId String @unique @map("user_id")

  displayName String @map("display_name")
  /// Identificador público en la URL: `vendox.com/<slug>`. Global y único.
  slug        String @unique

  bio       String?
  avatarUrl String? @map("avatar_url")
  coverUrl  String? @map("cover_url")

  /// Nace ACTIVO.
  ///
  /// La alternativa —nacer en PENDING y esperar aprobación— deja la vidriera
  /// invisible hasta que alguien la revise, y hoy no hay quién: el panel de
  /// administración todavía no existe. Un vendedor que carga diez productos y
  /// no los ve publicados abandona.
  ///
  /// La moderación es REACTIVA: se suspende ante una denuncia. `PENDING` queda
  /// en el enum para cuando exista revisión previa —por ejemplo para otorgar
  /// el sello de verificado— y para poder frenar a alguien sin bloquearlo.
  status             SellerStatus       @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")

  // ─── Riesgo ───
  //
  // Denormalizado acá y no en una tabla aparte: el panel filtra y ordena por
  // esto en cada listado, y una unión por vendedor se pagaría en todas las
  // pantallas para un dato que cambia pocas veces por día.
  //
  // Se recalcula cuando cambia algo que lo afecta, no en cada lectura: evaluar
  // las reglas consulta órdenes, devoluciones y sanciones, y hacerlo por fila
  // en cada listado sería una consulta pesada multiplicada por veinte.
  riskLevel      SellerRiskLevel @default(MEDIUM) @map("risk_level")
  /// Por qué. Un nivel sin motivos no le sirve a quien tiene que decidir algo.
  riskReasons    String[]        @default([]) @map("risk_reasons")
  riskComputedAt DateTime?       @map("risk_computed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores          Store[]
  orders          Order[]
  paymentAccounts SellerPaymentAccount[]
  oauthStates     OAuthState[]
  // Una por proveedor. Hoy sólo Mercado Pago, pero el día que haya otro no
  // hay que migrar la relación.
  oauthCredentials SellerOAuthCredential[]
  verification    SellerVerification?
  /// Denormalizados. Las restricciones únicas de Follow y Review son lo que
  /// los hace confiables: el incremento va en la MISMA transacción que la
  /// fila, y un duplicado deshace las dos cosas juntas.
  followersCount  Int                    @default(0) @map("followers_count")
  ratingSum       Int                    @default(0) @map("rating_sum")
  ratingCount     Int                    @default(0) @map("rating_count")

  liveSessions LiveSession[]
  followers    Follow[]
  reviews      Review[]

  @@index([status, createdAt])
  @@index([riskLevel, status])
  @@map("sellers")
}

/// Tienda.
///
/// Hoy cada vendedor tiene UNA, creada junto con el Seller. La tabla igual
/// modela la relación como 1:N y `isPrimary` marca cuál es la principal.
///
/// No es sobre-ingeniería: pasar de 1:1 a 1:N después obligaría a migrar
/// `storeId` en productos, variantes, órdenes e inventario, con datos vivos.
/// El costo hoy es una columna booleana.
model Store {
  id       String @id // sto_<ulid>
  sellerId String @map("seller_id")

  name        String
  /// Global y único: la tienda tiene URL propia.
  slug        String  @unique
  description String?
  logoUrl     String? @map("logo_url")
  coverUrl    String? @map("cover_url")

  status    StoreStatus @default(ACTIVE)

  // ═══════════════════════════════════════════════════════════════════════
  // ENVÍO — V1 MANUAL
  // ═══════════════════════════════════════════════════════════════════════
  //
  // El vendedor define su costo a mano. No hay cálculo por transportista
  // todavía: cotizar contra un carrier necesita peso, volumen y origen, y
  // pedirle eso a alguien que vende tejidos por Instagram es pedirle que
  // abandone. Cuando exista la integración, este campo pasa a ser el respaldo.
  //
  // El comprador lo ve ANTES de pagar, siempre.
  shippingMode  ShippingMode @default(FREE) @map("shipping_mode")
  /// Cuánto cobra por el envío. Sólo aplica en `FIXED_PRICE` y `FIXED_OR_PICKUP`.
  shippingFlatAmount Int @default(0) @map("shipping_flat_amount")
  /// Aclaración del vendedor: "Envíos los martes", "Retiro por Palermo".
  shippingNote String? @map("shipping_note")

  // ═══════════════════════════════════════════════════════════════════════
  // COSTO DEL PROCESADOR
  // ═══════════════════════════════════════════════════════════════════════
  //
  // El costo de Mercado Pago es del vendedor. Puede absorberlo o trasladarlo,
  // siempre que el medio y la normativa lo permitan.
  //
  // ⚠️ La tasa REAL la informa Mercado Pago después de cobrar y depende del
  // plazo de acreditación, el medio y el rubro. No se guarda un porcentaje
  // acá: hacerlo sería inventar un número y mostrárselo a alguien como si
  // fuera cierto. Lo que se guarda es quién lo paga.
  processorFeeMode ProcessorFeeMode @default(ABSORBED) @map("processor_fee_mode")

  // ═══════════════════════════════════════════════════════════════════════
  // CAMBIOS Y DEVOLUCIONES
  // ═══════════════════════════════════════════════════════════════════════
  //
  // El vendedor elige qué ofrece POR ENCIMA del piso legal. El piso —diez
  // días corridos de arrepentimiento desde la entrega, sin causa y sin costo—
  // se le muestra al comprador siempre, elija lo que elija el vendedor.
  //
  // Ver `modules/commerce/politicas.ts`, que tiene las citas y las reglas.
  exchangeMode ExchangeMode @default(SOLO_LEGAL) @map("exchange_mode")

  /// Días que ofrece el vendedor. Nunca se aplica menos que el piso legal.
  exchangeWindowDays Int @default(10) @map("exchange_window_days") @db.SmallInt

  /// Quién paga el envío de vuelta. En arrepentimiento puro, el vendedor.
  returnShippingPaidBy ReturnShippingPayer @default(VENDEDOR) @map("return_shipping_paid_by")

  /// Condiciones y excepciones, en las palabras del vendedor.
  exchangeNote String? @map("exchange_note")
  /// Tienda principal del vendedor. Hoy siempre hay exactamente una.
  isPrimary Boolean     @default(true) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller       Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products     Product[]
  variants     ProductVariant[]
  orders       Order[]
  liveSessions LiveSession[]
  schedule     StoreSchedule?

  @@index([sellerId, status])
  @@map("stores")
}

/// Categoría. Árbol simple, plano por ahora.
model Category {
  id       String  @id // cat_<ulid>
  name     String
  slug     String  @unique
  parentId String? @map("parent_id")
  position Int     @default(0) @db.SmallInt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

/// Producto.
///
/// ─── Por qué el precio vive acá Y en la variante ───
///
/// `basePriceCents` es el precio del producto. Una variante puede tener
/// `priceOverrideCents` cuando difiere —el talle XXL sale más caro— y `null`
/// cuando no. Guardar el precio SÓLO en la variante obligaría a escribir el
/// mismo número en las seis combinaciones de una remera, y a que cambiar el
/// precio fueran seis escrituras que pueden quedar a medias.
model Product {
  id         String  @id // prd_<ulid>
  storeId    String  @map("store_id")
  categoryId String? @map("category_id")

  name        String
  /// Único DENTRO de la tienda. Dos vendedores pueden tener "remera-negra".
  slug        String
  description String?

  status   ProductStatus @default(DRAFT)
  /// ISO 4217. Hoy siempre ARS; la columna existe para no migrar cuando deje
  /// de serlo.
  currency String        @default("ARS") @db.Char(3)

  /// Centavos. Ver la nota de convención al inicio del bloque.
  basePriceCents      Int  @map("base_price_cents")
  /// Precio tachado. DEBE ser mayor que el base o no se muestra: un "antes"
  /// menor que el "ahora" es publicidad engañosa.
  compareAtPriceCents Int? @map("compare_at_price_cents")

  /// Cuántos "me gusta" tiene. Denormalizado, igual que en el vivo.
  likesCount Int @default(0) @map("likes_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Borrado lógico.
  ///
  /// Una orden futura tiene que poder seguir apuntando al producto que se
  /// vendió. Borrarlo de verdad rompería el historial del comprador, el del
  /// vendedor y la contabilidad. Orders todavía no existe y por eso hay que
  /// dejarlo bien ahora: después ya hay datos.
  deletedAt DateTime? @map("deleted_at")

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options      ProductOption[]
  variants     ProductVariant[]
  images       ProductImage[]
  liveSessions LiveSessionProduct[]

  @@unique([storeId, slug])
  @@index([storeId, status, deletedAt])
  @@index([status, createdAt])
  @@map("products")
}

/// Eje de variación: "Color", "Talle", "Capacidad", "Sabor".
///
/// ─── Por qué una tabla y no columnas ───
///
/// Con columnas `size`, `color`, `capacity`, cada categoría nueva de producto
/// obliga a una migración, y el 90 % de las filas quedan en `null`. Una tabla
/// de opciones deja que el vendedor invente el eje que necesite —"Aroma",
/// "Largo de cordón"— sin tocar la base.
model ProductOption {
  id        String @id // opt_<ulid>
  productId String @map("product_id")

  name     String
  /// Orden en que se muestran y en que se arma el título de la variante:
  /// "Negro / M" y no "M / Negro".
  position Int    @default(0) @db.SmallInt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id // opv_<ulid>
  optionId String @map("option_id")

  value    String
  position Int    @default(0) @db.SmallInt

  option   ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOption[]

  @@unique([optionId, value])
  @@index([optionId, position])
  @@map("product_option_values")
}

/// Variante: lo que de verdad se vende y lo que va a tener stock.
///
/// ─── Todo producto tiene al menos una ───
///
/// Un producto "sin variantes" recibe una `DEFAULT` automática. Sin eso
/// habría dos arquitecturas de inventario —stock de producto y stock de
/// variante— y cada consulta de stock tendría que preguntar cuál de las dos
/// aplica. Inventory va a apuntar SIEMPRE a `productVariantId`.
model ProductVariant {
  id        String @id // var_<ulid>
  productId String @map("product_id")

  /// Desnormalizado desde el producto.
  ///
  /// Existe sólo para que el SKU pueda ser único POR TIENDA con un índice de
  /// base de datos. Sin esta columna, la unicidad habría que comprobarla en
  /// código con una consulta previa, y ahí hay una ventana de carrera. Los
  /// productos no cambian de tienda, así que no se desincroniza.
  storeId String @map("store_id")

  /// Código interno del vendedor. Opcional: muchos no usan.
  sku String?

  /// "Negro / M". Derivado de los valores de opción al crear o modificar.
  /// Se guarda para no resolver tres tablas cada vez que se lista un carrito.
  title String @default("Default")

  /// Precio propio. `null` = usa el del producto.
  priceOverrideCents          Int? @map("price_override_cents")
  compareAtPriceOverrideCents Int? @map("compare_at_price_override_cents")

  status    VariantStatus @default(ACTIVE)
  /// La variante única de un producto sin opciones.
  isDefault Boolean       @default(false) @map("is_default")
  position  Int           @default(0) @db.SmallInt

  /**
   * Huella canónica de la combinación de opciones.
   * Es la concatenación ordenada de los ids de valor. Existe para que la base
   * —y no el código— garantice que no haya dos variantes con la misma
   * combinación. Comprobarlo en código deja una ventana de carrera entre la
   * consulta y la inserción, y dos "Negro / M" en el mismo producto rompen el
   * inventario de forma silenciosa.
   */
  optionsKey String @map("options_key")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  options   ProductVariantOption[]
  inventory Inventory?
  intents   PurchaseIntent[]

  @@unique([productId, optionsKey])
  @@unique([storeId, sku])
  @@index([productId, status])
  @@map("product_variants")
}

/// Une una variante con los valores de opción que la definen.
model ProductVariantOption {
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("product_variant_options")
}

/// Imagen de producto.
///
/// El archivo NUNCA vive en PostgreSQL. Acá va la referencia; los bytes están
/// en el proveedor de almacenamiento (R2 en producción, disco en desarrollo).
///
/// `position = 0` es la principal.
model ProductImage {
  id        String @id // img_<ulid>
  productId String @map("product_id")

  /// URL pública para mostrar.
  url        String
  /// Ruta interna en el proveedor. Es lo que se usa para BORRAR el archivo:
  /// derivarla de la URL sería frágil ante un cambio de dominio o de CDN.
  storageKey String @map("storage_key")

  position Int     @default(0) @db.SmallInt
  altText  String? @map("alt_text")

  width     Int?
  height    Int?
  sizeBytes Int?   @map("size_bytes")
  mimeType  String @map("mime_type")

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Índice, no UNIQUE.
  ///
  /// Con `@@unique([productId, position])`, reordenar exigiría mover las filas
  /// a posiciones temporales para no chocar consigo mismas a mitad de camino.
  /// El orden se mantiene en una transacción del servicio.
  @@index([productId, position])
  @@map("product_images")
}

/// Bitácora de auditoría general.
///
/// Append-only. Responde "quién cambió esto y cuándo" seis meses después, que
/// es exactamente cuando nadie se acuerda.
model AuditLog {
  id String @id // aud_<ulid>

  /// `user`, `system`, `admin`.
  actorType String  @map("actor_type")
  actorId   String? @map("actor_id")

  /// `seller.created`, `product.archived`, `variant.deleted`.
  action String

  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Estado antes y después. Sólo los campos que cambiaron, y nunca datos
  /// sensibles: la auditoría se lee entera cuando se investiga algo.
  before Json?
  after  Json?

  /// Por qué se hizo.
  ///
  /// ─── Por qué esto es una columna y no un campo más dentro de `after` ───
  ///
  /// Porque es lo primero que se busca cuando algo se investiga. "¿Por qué
  /// suspendieron a este vendedor?" se responde leyendo esta columna, no
  /// arqueando un JSON.
  ///
  /// Obligatorio en toda acción administrativa: el backend rechaza la petición
  /// sin él. Un registro de auditoría que dice *qué* pasó pero no *por qué* es
  /// la mitad inútil de la bitácora — seis meses después nadie se acuerda, y
  /// la persona que lo hizo puede no estar más en el equipo.
  reason String?

  ip        String?
  userAgent String? @map("user_agent")
  traceId   String? @map("trace_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  /// Para el listado general del panel, que ordena por fecha sin filtrar.
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// INVENTARIO
//
// ─── El principio que ordena todo este bloque ───
//
// **PostgreSQL es la única autoridad sobre el stock.** Redis no decide stock.
// Flutter no decide stock. LiveKit no decide stock.
//
// Durante un vivo, cien personas pueden tocar "Comprar" sobre la última unidad
// en el mismo segundo. La única forma de que eso no termine en sobreventa es
// que la decisión la tome el motor de la base, en una sola sentencia, y no un
// `if` de TypeScript que leyó el stock un milisegundo antes.
//
// Por eso este bloque tiene tres capas de defensa, de afuera hacia adentro:
//
//   1. El UPDATE condicional decide. `WHERE (on_hand - reserved) >= qty`.
//      Cero filas afectadas significa "no había". No hay lectura previa.
//   2. Los CHECK de la tabla lo hacen imposible. Aunque el código tenga un
//      bug, la base rechaza `reserved > on_hand`.
//   3. Los índices únicos parciales evitan duplicados que el código no ve.
//
// Cualquiera de las tres sola sería suficiente en el camino feliz. Las tres
// juntas son lo que hace que un error de programación futuro se manifieste
// como una transacción rechazada y no como una unidad vendida dos veces.
// ═══════════════════════════════════════════════════════════════════════════

/// Existencias de UNA variante.
///
/// ─── Por qué cuelga de la variante y nunca del producto ───
///
/// Todo producto tiene al menos una variante: los simples reciben una
/// `DEFAULT` automática. Gracias a eso el inventario apunta SIEMPRE a
/// `productVariantId` y no hay dos lógicas de stock conviviendo. Si colgara
/// del producto cuando no hay opciones y de la variante cuando sí, cada
/// consulta de disponibilidad tendría que preguntar antes cuál de las dos
/// aplica — y algún día alguien se olvidaría de preguntar.
///
/// ─── Por qué no hay columna `version` ───
///
/// El bloqueo optimista con `version` resuelve el mismo problema que ya
/// resuelve el UPDATE condicional, pero peor: obliga a reintentar en el código
/// cuando dos peticiones chocan. Con `WHERE (on_hand - reserved) >= qty` el
/// motor serializa las escrituras sobre la fila y la respuesta es definitiva
/// en un solo viaje, sin reintentos. Agregar `version` sería maquinaria que no
/// compra nada.
model Inventory {
  id String @id // inv_<ulid>

  productVariantId String @unique @map("product_variant_id")

  /// Unidades que existen físicamente.
  onHand Int @default(0) @map("on_hand")

  /// Unidades apartadas por compradores que todavía no terminaron.
  ///
  /// El vendedor NUNCA escribe este número: es consecuencia de las reservas
  /// vivas. Un endpoint que lo dejara editar permitiría "liberar" stock que
  /// alguien ya tiene apartado y vender la misma unidad dos veces.
  reserved Int @default(0)

  /// Umbral de "quedan pocas". `null` = usa el valor por defecto del sistema.
  lowStockThreshold Int? @map("low_stock_threshold")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant      ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@map("inventory")
}

/// Reserva temporal de stock.
///
/// ─── Qué es y qué no es ───
///
/// Es un apartado de UNIDADES por un rato. **No es una orden disfrazada**: no
/// congela precio, no guarda datos del comprador, no representa una intención
/// de compra vinculante. Cuando llegue Orders, la orden tendrá su propia foto
/// del precio, del nombre y del vendedor, y consumirá esta reserva.
///
/// Mezclar las dos cosas ahora significaría migrar datos después.
///
/// ─── Por qué no se borran ───
///
/// Una reserva vencida o consumida es la única evidencia de por qué el stock
/// se movió. Cuando un vendedor pregunte "¿por qué figuraba agotado a las
/// 21:04 si tenía tres?", la respuesta está en estas filas.
model InventoryReservation {
  id String @id // rsv_<ulid>

  inventoryId String @map("inventory_id")

  /// Desnormalizado desde el inventario.
  ///
  /// Permite indexar por variante sin un join y —más importante— hace que el
  /// índice único parcial de "una reserva activa por persona y variante" se
  /// pueda expresar en una sola tabla.
  productVariantId String @map("product_variant_id")

  userId String @map("user_id")

  quantity Int

  status ReservationStatus @default(ACTIVE)

  /**
   * Clave de idempotencia, generada por el cliente.
   * ─── Por qué es única por USUARIO y no globalmente ───
   * La clave la elige la app, así que no hay nada que garantice que dos
   * personas no manden la misma. Con unicidad global, la petición de la
   * segunda chocaría con la de la primera y —según cómo se resuelva el
   * conflicto— podría devolverle la reserva de otro. Es una fuga entre
   * cuentas provocada por una colisión de UUID.
   * Acotada al usuario, esa colisión es inofensiva: cada uno vive en su
   * propio espacio de claves.
   */
  idempotencyKey String @map("idempotency_key")

  /**
   * Huella del cuerpo de la petición.
   * Reusar una clave con un cuerpo distinto casi siempre es un error del
   * cliente —reutilizó la clave de otro intento— y devolverle en silencio la
   * reserva anterior le haría creer que reservó tres cuando pidió una. Se
   * compara y se rechaza explícitamente.
   */
  requestHash String @map("request_hash")

  /// Vencimiento, calculado SIEMPRE por el backend. El cliente no opina.
  expiresAt DateTime @map("expires_at")

  consumedAt  DateTime? @map("consumed_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiredAt   DateTime? @map("expired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  /**
   * ⚠️ Dos índices de esta tabla NO están acá y se crean a mano en la
   * migración, porque Prisma no sabe expresar índices parciales:
   * · `reserva_activa_unica_por_usuario_y_variante` — UNIQUE sobre
   * (user_id, product_variant_id) WHERE status = 'ACTIVE'. Es lo que
   * impide apartar la misma unidad dos veces con un doble toque.
   * · `reservas_activas_por_vencimiento` — el barrido del reconciliador.
   * Si algún día un `prisma migrate dev` propone borrarlos, **no lo dejes**:
   * volvelos a agregar a mano. El test "una sola reserva ACTIVA por usuario y
   * variante" se pone en rojo si desaparecen.
   */
  /// "Mis reservas activas", que la app consulta al volver del segundo plano.
  @@index([userId, status])
  @@index([productVariantId, status])
  @@index([inventoryId, status])
  @@map("inventory_reservations")
}

/// Estados de una reserva. Las transiciones válidas están en `reservations.ts`.
enum ReservationStatus {
  /// Stock apartado. Es el único estado que ocupa unidades en `reserved`.
  ACTIVE
  /// Se convirtió en venta: descontó de `onHand` y liberó `reserved`.
  CONSUMED
  /// Se venció sola. Liberó `reserved` sin tocar `onHand`.
  EXPIRED
  /// La soltó el comprador. Liberó `reserved` sin tocar `onHand`.
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════════════════
// ÓRDENES Y PAGOS DE PRODUCCIÓN
//
// ─── El principio ───
//
// **Una venta no existe porque el cliente dijo que pagó.** Existe cuando el
// backend verificó el dinero contra el proveedor Y pudo confirmar el
// inventario sin romper ninguna invariante.
//
// De ahí salen las tres decisiones que estructuran todo lo de abajo:
//
//   1. `PAID` y `CONFIRMED` son estados DISTINTOS. Puede haber plata acreditada
//      sin inventario confirmado, y esconderlo detrás de un solo estado
//      convierte un problema visible en uno silencioso.
//   2. Los intentos de cobro son FILAS, no un campo que se sobrescribe. Una
//      orden puede intentar con Visa, que rechaza, y después con Mastercard.
//      Son dos hechos distintos y los dos importan.
//   3. La orden guarda FOTOS de todo lo que puede cambiar. Dentro de dos años
//      tiene que poder responder qué compró esa persona, a qué precio y a qué
//      dirección — aunque el producto ya no exista y el precio sea otro.
// ═══════════════════════════════════════════════════════════════════════════

/// Una compra a UN vendedor.
///
/// ─── Por qué una orden = un vendedor ───
///
/// Comprarle a dos vendedores genera dos órdenes. Cada una tiene su envío, su
/// comisión, su plata que va a una cuenta distinta y su propio estado de
/// preparación. Meterlas en una sola obligaría a que cada consulta empiece
/// preguntando de qué vendedor se está hablando.
///
/// Si algún día hace falta un carrito que las agrupe, se agrega un
/// `CheckoutSession` por encima y estas filas no cambian.
model Order {
  id String @id // ord_<ulid>

  /// Número corto para hablar con soporte: "mi pedido A4F2K9". Los ULID son
  /// ilegibles por teléfono y nadie los dicta bien.
  reference String @unique

  buyerId  String @map("buyer_id")
  storeId  String @map("store_id")
  /// Desnormalizado desde la tienda: el panel del vendedor filtra por acá y
  /// las tiendas no cambian de dueño.
  sellerId String @map("seller_id")

  /// La reserva de stock que respalda esta orden.
  ///
  /// Único: una reserva no puede respaldar dos órdenes. Sin esta restricción,
  /// dos peticiones simultáneas con la misma reserva crearían dos órdenes
  /// compitiendo por las mismas unidades.
  ///
  /// Opcional porque una orden pagada sobrevive a su reserva: cuando el
  /// inventario se consume o se vence, la orden sigue existiendo.
  reservationId String? @unique @map("reservation_id")

  status OrderStatus @default(PENDING_PAYMENT)

  currency String @default("ARS")

  // ─── Fotos financieras ───
  //
  // Todo en centavos enteros, igual que el resto del proyecto. Sin decimales
  // flotantes en ningún lado: 0.1 + 0.2 no da 0.3, y en dinero eso se nota.

  itemsSubtotal  Int @map("items_subtotal")
  shippingAmount Int @default(0) @map("shipping_amount")

  /// Recargo por el medio de pago, si el vendedor lo traslada.
  ///
  /// Distinto de `paymentProcessorFeeAmount`, que es lo que el procesador
  /// COBRÓ de verdad y llega después. Este es lo que se le sumó al comprador,
  /// cerrado antes de pagar.
  processorSurchargeAmount Int @default(0) @map("processor_surcharge_amount")

  /// Foto de cómo se cobró el envío. La tienda puede cambiar su política
  /// mañana; este pedido tiene que seguir explicando por qué cobró lo que
  /// cobró.
  shippingModeSnapshot ShippingMode? @map("shipping_mode_snapshot")

  /// Foto de quién paga el costo del procesador.
  processorFeeModeSnapshot ProcessorFeeMode? @map("processor_fee_mode_snapshot")

  /// Si esta compra se retira en persona.
  ///
  /// No se deduce de `shippingAmount == 0`: hay tiendas con envío gratis, y
  /// confundir las dos cosas hace que el vendedor despache un paquete que la
  /// otra persona está esperando ir a buscar, o al revés — que nadie despache
  /// nada mientras el comprador espera en su casa.
  pickupSelected Boolean @default(false) @map("pickup_selected")
  discountAmount Int @default(0) @map("discount_amount")
  /// Lo que paga el comprador.
  grossAmount    Int @map("gross_amount")

  /// El porcentaje de comisión VIGENTE AL CREAR LA ORDEN, no el actual.
  ///
  /// Si mañana VendoX pasa a cobrar 8 %, esta orden tiene que seguir diciendo
  /// 6 % para siempre. Leerlo de una variable de entorno al mostrar el detalle
  /// reescribiría la historia contable de forma retroactiva y silenciosa.
  ///
  /// En puntos básicos —600 = 6,00 %— para poder expresar 6,5 % sin decimales.
  platformFeeBps    Int @map("platform_fee_bps")
  platformFeeAmount Int @map("platform_fee_amount")

  /// Lo que cobró Mercado Pago. `null` hasta que ELLOS lo informen.
  ///
  /// No se estima. Una estimación guardada en la misma columna que un dato
  /// real es indistinguible de un dato real seis meses después, y la
  /// diferencia aparece cuando alguien concilia contra el extracto bancario.
  paymentProcessorFeeAmount Int? @map("payment_processor_fee_amount")

  /// Lo que le queda al vendedor. Se recalcula cuando llega el costo real.
  sellerNetAmount Int @map("seller_net_amount")

  /// Foto de la dirección. Cambiarla en el perfil no toca las órdenes viejas.
  shippingAddress Json @map("shipping_address")
  /// Nombre y contacto del comprador al momento de comprar.
  buyerSnapshot   Json @map("buyer_snapshot")

  /// Por qué se canceló o por qué hace falta devolver. Se muestra al comprador.
  statusReason String? @map("status_reason")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  paidAt      DateTime? @map("paid_at")
  confirmedAt DateTime? @map("confirmed_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiredAt   DateTime? @map("expired_at")
  refundedAt  DateTime? @map("refunded_at")

  // ─── Preparación y entrega ───
  //
  // Se guarda CUÁNDO pasó cada cosa, no sólo el estado actual. El estado dice
  // dónde está el pedido; estas marcas dicen cuánto tardó cada paso, que es lo
  // que después permite hablar de demoras sin inventar.
  preparingAt DateTime? @map("preparing_at")
  readyAt     DateTime? @map("ready_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")

  /// El código que el comprador le dice al repartidor. Seis dígitos.
  ///
  /// ⚠️ NUNCA sale en una respuesta del vendedor ni aparece en logs. Se guarda
  /// en claro a propósito: el comprador tiene que poder leerlo cada vez que
  /// abre su pedido, no una sola vez. La explicación está en `delivery-code.ts`.
  deliveryCode         String?   @map("delivery_code")
  deliveryCodeIssuedAt DateTime? @map("delivery_code_issued_at")
  /// Intentos fallidos seguidos. Se reinicia al confirmar.
  deliveryCodeAttempts Int       @default(0) @map("delivery_code_attempts")
  /// Hasta cuándo no se aceptan más intentos.
  deliveryCodeLockedUntil DateTime? @map("delivery_code_locked_until")

  buyer    User             @relation(fields: [buyerId], references: [id])
  store    Store            @relation(fields: [storeId], references: [id])
  seller   Seller           @relation(fields: [sellerId], references: [id])
  items    OrderItem[]
  attempts PaymentAttempt[]
  refunds  Refund[]
  review   Review?

  @@index([buyerId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([storeId, createdAt])
  /// El barrido de órdenes sin pagar.
  @@index([status, createdAt])
  @@map("orders")
}

/// Una línea de la orden, con todo copiado.
///
/// No guarda sólo referencias: si el vendedor archiva el producto, le cambia
/// el nombre o le sube el precio, el historial del comprador tiene que seguir
/// mostrando lo que compró y lo que pagó.
model OrderItem {
  id      String @id // oit_<ulid>
  orderId String @map("order_id")

  /// Referencias para trazar. Pueden apuntar a algo borrado lógicamente.
  productId        String @map("product_id")
  productVariantId String @map("product_variant_id")

  // ─── Fotos ───
  productNameSnapshot  String  @map("product_name_snapshot")
  variantLabelSnapshot String  @map("variant_label_snapshot")
  skuSnapshot          String? @map("sku_snapshot")
  imageUrlSnapshot     String? @map("image_url_snapshot")

  quantity  Int
  unitPrice Int @map("unit_price")
  subtotal  Int

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

/// Un intento de cobro.
///
/// ─── Por qué es una fila y no un campo de la orden ───
///
/// Una orden puede intentarse con Visa —rechazada— y después con Mastercard
/// —aprobada—. Con un solo registro mutable, el primer intento desaparece: se
/// pierde por qué se rechazó, con qué tarjeta y cuándo. Y esa es exactamente
/// la información que se necesita cuando alguien reclama.
model PaymentAttempt {
  id      String @id // pat_<ulid>
  orderId String @map("order_id")

  provider          PaymentProvider @default(MERCADO_PAGO)
  /// Id del pago en el proveedor. `null` hasta que responda — y si nunca
  /// responde, ese `null` es justamente lo que hay que conciliar.
  providerPaymentId String?         @unique @map("provider_payment_id")

  status PaymentAttemptStatus @default(CREATED)

  amount   Int
  currency String @default("ARS")

  /// Clave de idempotencia, POR INTENTO.
  ///
  /// ─── El error que evita, ya cometido y medido ───
  ///
  /// La primera versión usaba una clave por ORDEN. En el reintento se mandaba
  /// la misma y Mercado Pago —haciendo lo correcto— devolvía la respuesta
  /// guardada del primer intento:
  ///
  ///     08:14:50  tarjeta rechazada  clave pay-ord_X  → pago 1350327873
  ///     08:15:39  otra tarjeta       clave pay-ord_X  → pago 1350327873, el MISMO
  ///
  /// El segundo cobro nunca se procesó. Una orden rechazada quedaba condenada:
  /// ninguna tarjeta podía pagarla nunca más.
  ///
  /// La clave identifica UN COBRO. Reintentar por red usa la misma; probar con
  /// otra tarjeta genera una nueva.
  idempotencyKey String @unique @map("idempotency_key")

  paymentMethodType String? @map("payment_method_type")
  brand             String? @map("brand")
  /// Los últimos cuatro. Es lo ÚNICO de la tarjeta que se guarda, junto con la
  /// marca. Nunca el PAN, nunca el código de seguridad, nunca el token.
  lastFour          String? @map("last_four")

  failureCode        String? @map("failure_code")
  /// Mensaje ya traducido y seguro. Nunca el crudo del proveedor.
  failureMessageSafe String? @map("failure_message_safe")

  /// Cuánto cobró el proveedor por este cobro, cuando lo informa.
  processorFeeAmount Int? @map("processor_fee_amount")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  approvedAt    DateTime? @map("approved_at")
  /// Última vez que se le preguntó al proveedor. Ordena el conciliador.
  lastCheckedAt DateTime? @map("last_checked_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId, createdAt])
  /// El barrido del conciliador: intentos en estado incierto.
  @@index([status, lastCheckedAt])
  @@map("payment_attempts")
}

/// Una devolución.
///
/// Existe como entidad y no como un par de campos en la orden porque una
/// devolución puede fallar técnicamente y hay que reintentarla, y porque
/// cuando alguien pregunta dónde está su plata, la respuesta tiene que estar
/// en una fila con fechas.
model Refund {
  id               String @id // ref_<ulid>
  orderId          String @map("order_id")
  paymentAttemptId String @map("payment_attempt_id")

  provider         PaymentProvider @default(MERCADO_PAGO)
  providerRefundId String?         @map("provider_refund_id")

  status RefundStatus @default(PENDING)
  amount Int

  /// Por qué se devuelve. `LATE_PAYMENT_OUT_OF_STOCK` es el caso principal.
  reason String

  failureMessageSafe String? @map("failure_message_safe")
  /// Cuántas veces se intentó. El conciliador no reintenta para siempre.
  attempts           Int     @default(0)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
  @@map("refunds")
}

/// Dirección de entrega de una persona.
///
/// Campos separados y no una línea de texto: el correo argentino necesita
/// calle, altura, piso y departamento por separado, y una cadena libre obliga
/// a adivinar dónde termina cada cosa.
model UserAddress {
  id     String @id // adr_<ulid>
  userId String @map("user_id")

  recipientFullName String @map("recipient_full_name")
  /// DNI o CUIL. Lo pide el correo para entregar y Mercado Pago para facturar.
  documentType      String @default("DNI") @map("document_type")
  documentNumber    String @map("document_number")
  phoneE164         String @map("phone_e164")

  street     String
  number     String
  floor      String?
  apartment  String?
  city       String
  province   String
  postalCode String  @map("postal_code")
  /// "Portón negro, timbre 3". Lo que evita que el pedido vuelva al depósito.
  references String?

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("user_addresses")
}

/// Conexión del vendedor con su procesador de pagos.
///
/// ─── Por qué existe antes de estar implementada ───
///
/// VendoX es un marketplace: la plata de una venta es del VENDEDOR, no de
/// VendoX. El modelo correcto es que cada vendedor conecte su cuenta de
/// Mercado Pago por OAuth y que VendoX cobre su comisión sobre esa
/// transacción.
///
/// Diseñar todo como si cobrara una cuenta central de VendoX y arreglarlo
/// después significa migrar dinero ya movido, que es la peor migración
/// posible. Así que el modelo está ahora aunque la conexión real dependa de
/// habilitación de Mercado Pago.
model SellerPaymentAccount {
  id       String @id // spa_<ulid>
  sellerId String @map("seller_id")

  provider          PaymentProvider @default(MERCADO_PAGO)
  /// El `user_id` del vendedor en Mercado Pago. NO es un secreto.
  providerAccountId String?         @map("provider_account_id")

  status SellerPaymentAccountStatus @default(NOT_CONNECTED)

  /// ⚠️ Los tokens NO se guardan acá.
  ///
  /// Un access token de OAuth de Mercado Pago permite cobrar en nombre del
  /// vendedor. En una columna de texto queda en los respaldos, en las réplicas
  /// y en cualquier volcado que alguien haga para depurar.
  ///
  /// Sólo se guarda la REFERENCIA al secreto en el gestor correspondiente. La
  /// columna con el token no existe a propósito: no se puede filtrar lo que no
  /// está.
  credentialRef String?   @map("credential_ref")
  scopes        String?
  expiresAt     DateTime? @map("expires_at")

  connectedAt    DateTime? @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, provider])
  @@map("seller_payment_accounts")
}

/// Estados de una orden. Las transiciones válidas están en `order-state.ts`.
enum OrderStatus {
  /// Creada, esperando que alguien la pague. El stock está apartado.
  PENDING_PAYMENT
  /// Hay un cobro en vuelo. No se puede lanzar otro.
  PROCESSING_PAYMENT
  /// Mercado Pago acreditó. El inventario TODAVÍA no está confirmado.
  PAID
  /// Plata acreditada Y stock consumido. La venta es válida.
  CONFIRMED
  /// El cobro se rechazó. Se puede reintentar con otra tarjeta.
  PAYMENT_FAILED
  /// Venció sin pagarse.
  EXPIRED
  CANCELLED

  /// ⚠️ Plata acreditada y stock imposible de confirmar.
  ///
  /// Es el estado que justifica separar PAID de CONFIRMED. Se llega cuando el
  /// pago se acredita tarde y otro comprador ya se llevó la última unidad. No
  /// se esconde: se devuelve la plata.
  PAYMENT_REQUIRES_REFUND
  REFUND_PENDING
  REFUNDED

  // ─── Preparación, una vez confirmada ───
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum PaymentAttemptStatus {
  CREATED
  /// Mandado al proveedor, sin respuesta definitiva.
  PROCESSING
  APPROVED
  /// Rechazo FINANCIERO: la tarjeta dijo que no.
  REJECTED
  CANCELLED
  REFUNDED

  /// No sabemos qué pasó.
  ///
  /// ─── Por qué esto NO es lo mismo que rechazado ───
  ///
  /// Si se manda el cobro y se pierde la conexión antes de conocer la
  /// respuesta, el pago pudo haberse procesado igual. Marcarlo `REJECTED`
  /// sería decirle a alguien que no le cobraron cuando sí, y dejarlo intentar
  /// de nuevo — cobrándole dos veces.
  ///
  /// Un error de red no es un pago fallido. Es un pago desconocido, y el
  /// conciliador lo resuelve preguntándole al proveedor.
  UNKNOWN_PENDING_RECONCILIATION
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  /// Falló técnicamente. La orden NO se da por resuelta: el conciliador vuelve.
  FAILED
}

enum SellerPaymentAccountStatus {
  NOT_CONNECTED
  CONNECTED
  EXPIRED
  REVOKED
}

// ═══════════════════════════════════════════════════════════════════════════
// VERIFICACIÓN DE VENDEDORES Y RIESGO
//
// ─── Las dos preguntas que NO son la misma ───
//
//   1. ¿Sabemos quién es esta persona?     → verificación de identidad
//   2. ¿Es un buen vendedor?               → reputación y riesgo
//
// Mezclarlas es el error clásico. Alguien con DNI verificado puede estafar; y
// alguien sin verificar puede llevar dos años vendiendo bien. Un solo campo
// "confiable" mezclaría las dos cosas y no serviría para ninguna.
//
// Por eso son dos conceptos separados, con dos insignias distintas de cara al
// comprador: **IDENTIDAD VERIFICADA** es un hecho comprobable; **VENDEDOR
// CONFIABLE** es un historial. No deben mostrarse como lo mismo.
// ═══════════════════════════════════════════════════════════════════════════

enum SellerVerificationState {
  /// Todavía no mandó nada.
  NOT_STARTED
  /// Envió sus datos. Espera revisión.
  PENDING
  /// Alguien la está revisando.
  IN_REVIEW
  VERIFIED
  REJECTED
}

/// Cuánto riesgo representa un vendedor. Tres niveles y con motivos: un puntaje
/// de 0 a 100 sin explicación no le sirve a quien tiene que decidir algo.
enum SellerRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model SellerVerification {
  id       String @id // ver_<ulid>
  sellerId String @unique @map("seller_id")

  state SellerVerificationState @default(NOT_STARTED)

  /// Nombre tal como figura en el documento. Puede diferir del nombre de la
  /// cuenta, que viene de Google o Apple.
  legalFirstName String? @map("legal_first_name")
  legalLastName  String? @map("legal_last_name")

  // ───────────────────────────────────────────────────────────────────────────
  // EL DOCUMENTO NO SE GUARDA COMPLETO. NUNCA.
  //
  // Se guarda un HMAC y los últimos cuatro dígitos, y nada más.
  //
  // ─── Por qué alcanza ───
  //
  //   · El hash permite detectar el mismo DNI en dos cuentas distintas, que es
  //     una de las señales de fraude más fuertes que existen. Y lo hace sin que
  //     el número esté en ningún lado.
  //   · Los últimos cuatro alcanzan para que soporte confirme con la persona
  //     que hablan del mismo documento.
  //
  // ─── Por qué no se guarda entero ───
  //
  // Porque un número de documento completo, en una base sin cifrado a nivel de
  // columna, es exactamente el dato que convierte una filtración en un
  // problema de identidad para gente real. Y hoy no lo necesitamos: no hay
  // integración con RENAPER todavía, así que el número sólo existe durante la
  // petición que lo envía.
  //
  // Cuando exista el proveedor real, se verifica EN ESE MOMENTO y se guarda el
  // resultado, no el insumo. Si hiciera falta re-verificar, la persona lo
  // vuelve a escribir.
  // ───────────────────────────────────────────────────────────────────────────
  docType        String? @map("doc_type")
  docNumberHash  String? @map("doc_number_hash")
  docNumberLast4 String? @map("doc_number_last4")

  /// CUIT/CUIL, con el mismo tratamiento.
  taxIdHash  String? @map("tax_id_hash")
  taxIdLast4 String? @map("tax_id_last4")

  province String?
  city     String?

  // ─── Resultado de los proveedores externos ───
  //
  // Todavía NO hay integración con RENAPER ni ARCA. Estas columnas existen
  // para que el adaptador se enchufe sin migración, y hoy las llena el
  // proveedor manual: una persona del equipo revisando.
  //
  // No se inventa que la integración existe. `identityProvider = 'manual'` dice
  // la verdad.
  identityProvider  String?   @map("identity_provider")
  identityCheckedAt DateTime? @map("identity_checked_at")
  identityResult    String?   @map("identity_result")

  taxProvider  String?   @map("tax_provider")
  taxCheckedAt DateTime? @map("tax_checked_at")
  taxResult    String?   @map("tax_result")

  submittedAt     DateTime? @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  /// Qué admin la revisó. Para poder preguntarle.
  reviewedBy      String?   @map("reviewed_by")
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Para encontrar el mismo documento en dos cuentas. La señal de fraude más
  /// directa que tenemos.
  @@index([docNumberHash])
  @@index([taxIdHash])
  @@index([state, submittedAt])
  @@map("seller_verifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// SESIONES EN VIVO
//
// ─── La separación que ordena todo el bloque ───
//
//   VIDEO      → LiveKit
//   COMERCIO   → backend + capa realtime propia
//
// El stock, las órdenes y los pagos **nunca** viven dentro de LiveKit. LiveKit
// transporta audio y video; si además fuera la fuente de qué producto está
// destacado o cuánto stock queda, tendríamos estado crítico en un sistema que
// no es transaccional y que se reinicia solo cuando una sala queda vacía.
//
// La capa realtime avisa que algo cambió. Quién decide qué cambió es PostgreSQL.
// ═══════════════════════════════════════════════════════════════════════════

enum LiveSessionState {
  /// Creada, con productos preparados, cámara todavía apagada.
  ///
  /// Existe porque tocar "Iniciar LIVE" no puede encender la cámara en público
  /// de una: quien transmite necesita ver el encuadre, elegir productos y
  /// probar el micrófono antes de que lo vea alguien.
  SCHEDULED
  /// Conectando con LiveKit. Todavía no hay video publicado.
  STARTING
  LIVE
  /// El broadcaster perdió la conexión. La sesión sigue existiendo y los
  /// espectadores siguen en la sala.
  RECONNECTING
  /// Cerrando: se calcula el resumen y se desconecta a todo el mundo.
  ENDING
  ENDED
  /// No pudo arrancar. Estado terminal distinto de ENDED para poder contar
  /// cuántos vivos fallan al iniciar, que es una métrica de producto.
  FAILED
}

model LiveSession {
  id       String @id // liv_<ulid>
  sellerId String @map("seller_id")
  storeId  String @map("store_id")

  title    String
  coverUrl String? @map("cover_url")

  state LiveSessionState @default(SCHEDULED)

  /// Nombre de la sala en LiveKit. Derivado del id, único.
  roomName String @unique @map("room_name")

  /// Qué producto está mostrando AHORA.
  ///
  /// Se guarda la variante y no sólo el producto: lo que se compra es una
  /// variante, y el panel del comprador necesita precio y stock concretos. Un
  /// producto con seis talles no tiene "un" stock.
  featuredVariantId String?   @map("featured_variant_id")
  featuredAt        DateTime? @map("featured_at")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  // ─── Resumen, calculado al terminar ───
  //
  // Se persiste en vez de recalcularse: las órdenes de un vivo se pueden
  // cancelar o devolver después, y el resumen tiene que decir qué pasó DURANTE
  // la transmisión. Recalcularlo un mes más tarde daría otro número.
  peakViewers   Int? @map("peak_viewers")

  /// Cuántos "me gusta" tiene. Denormalizado.
  ///
  /// Contar la tabla en cada tarjeta del feed sería una consulta agregada por
  /// fila en la pantalla más visitada de la app. Se mantiene en la misma
  /// transacción que el "me gusta", así que no se puede despegar.
  likesCount    Int  @default(0) @map("likes_count")
  uniqueViewers Int? @map("unique_viewers")
  totalOrders   Int? @map("total_orders")
  grossAmount   Int? @map("gross_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller   Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products LiveSessionProduct[]

  /// Para el feed: los vivos activos, primero los más recientes.
  @@index([state, startedAt])
  @@index([sellerId, createdAt])
  @@map("live_sessions")
}

/// La bandeja de productos del vivo.
///
/// Se preparan ANTES de salir al aire. Durante la transmisión, destacar uno es
/// un toque: buscar en el catálogo entero con la cámara encendida es imposible
/// de hacer bien.
model LiveSessionProduct {
  id            String @id // lsp_<ulid>
  liveSessionId String @map("live_session_id")
  productId     String @map("product_id")

  position Int @default(0) @db.SmallInt

  /// Cuántas veces se destacó y cuándo fue la última. Para el resumen final.
  featuredCount  Int       @default(0) @map("featured_count")
  lastFeaturedAt DateTime? @map("last_featured_at")

  createdAt DateTime @default(now()) @map("created_at")

  session LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Un producto no puede estar dos veces en la misma bandeja.
  @@unique([liveSessionId, productId])
  @@index([liveSessionId, position])
  @@map("live_session_products")
}

// ═══════════════════════════════════════════════════════════════════════════
// HORARIOS DE TIENDA
//
// ─── Tres cosas distintas que no hay que mezclar ───
//
//   SellerStatus     ACTIVE / SUSPENDED / BLOCKED   ← ¿está habilitado?
//   StoreStatus      ACTIVE / PAUSED / CLOSED       ← ¿el dueño la abrió?
//   Horario          abierta / cerrada ahora        ← ¿es hora de atender?
//
// Un vendedor habilitado, con la tienda activa, puede estar cerrado porque son
// las tres de la mañana. Y un vivo puede terminar con la tienda siguiendo
// abierta — que es exactamente lo que permite seguir vendiendo después.
//
// Sin esta separación terminaríamos con booleanos sueltos por todos lados y
// nadie sabría cuál manda.
// ═══════════════════════════════════════════════════════════════════════════

enum StoreOpeningMode {
  /// Siempre se puede comprar. Lo natural para quien vende por catálogo.
  ALWAYS_OPEN
  /// Por franjas horarias.
  SCHEDULED
  /// Sólo mientras hay una transmisión. Para quien vende exclusivamente en vivo.
  LIVE_ONLY
}

model StoreSchedule {
  id      String @id // sch_<ulid>
  storeId String @unique @map("store_id")

  mode StoreOpeningMode @default(ALWAYS_OPEN)

  /// Zona horaria de la tienda.
  ///
  /// Se guarda aunque hoy todas sean argentinas: un horario sin zona es
  /// ambiguo, y el día que haya un vendedor con otro huso —o que Argentina
  /// vuelva al horario de verano— la interpretación cambia.
  timezone String @default("America/Argentina/Buenos_Aires")

  /// Si la tienda estaba abierta la última vez que se miró.
  ///
  /// ═══════════════════════════════════════════════════════════════════════
  /// EXISTE PORQUE "REABRIR" NO ES UN EVENTO
  /// ═══════════════════════════════════════════════════════════════════════
  ///
  /// Que una tienda esté abierta se CALCULA: es el horario, la zona y la hora
  /// actual. Nadie aprieta un botón a las nueve de la mañana. Así que no hay
  /// ningún momento en el que el sistema se entere de que abrió, y sin eso no
  /// hay a quién avisarle.
  ///
  /// Guardar el último estado conocido convierte el cálculo en una transición:
  /// el barrido compara lo que da la cuenta con lo que dice esta columna, y
  /// cuando pasa de `false` a `true` es exactamente el instante de la
  /// reapertura.
  ///
  /// Arranca en `true` a propósito. Con `false`, la primera corrida del barrido
  /// vería una transición falsa en TODAS las tiendas y les mandaría un aviso de
  /// reapertura a todos los interesados de golpe.
  wasOpen Boolean @default(true) @map("was_open")

  /// Cuándo fue la última reapertura detectada.
  ///
  /// Es lo que hace única la clave de deduplicación del aviso: dos barridos
  /// simultáneos sobre la misma reapertura escriben la misma clave y el índice
  /// único deja pasar uno solo, pero la reapertura del día siguiente sí manda
  /// un aviso nuevo.
  lastReopenedAt DateTime? @map("last_reopened_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slots StoreScheduleSlot[]

  /// El barrido de reaperturas: las que estaban cerradas la última vez.
  @@index([wasOpen])
  @@map("store_schedules")
}

/// Una franja de atención.
///
/// Varias por día permiten el corte del mediodía sin inventar un campo
/// "descanso": dos franjas de 9 a 13 y de 16 a 20 dicen lo mismo y son más
/// simples de razonar.
model StoreScheduleSlot {
  id         String @id // sls_<ulid>
  scheduleId String @map("schedule_id")

  /// 0 = domingo, 6 = sábado. Igual que `Date.getDay()`.
  weekday Int @db.SmallInt

  /// Minutos desde medianoche.
  ///
  /// ─── Por qué no "09:00" ni un DateTime ───
  ///
  /// Una hora del día NO es un instante: no tiene fecha, y guardarla como
  /// `DateTime` obliga a inventar una y a acordarse de ignorarla siempre.
  /// Una cadena "09:00" se puede escribir mal de diez formas y hay que
  /// parsearla en cada comparación.
  ///
  /// Un entero se compara con `<` y no admite estados imposibles.
  opensAtMinutes Int @map("opens_at_minutes") @db.SmallInt

  /// Si es MENOR que el de apertura, la franja cruza la medianoche.
  /// De 22:00 a 02:00 es un caso real de quien vende de noche.
  closesAtMinutes Int @map("closes_at_minutes") @db.SmallInt

  schedule StoreSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, weekday])
  @@map("store_schedule_slots")
}

// ═══════════════════════════════════════════════════════════════════════════
// SEGUIDORES
// ═══════════════════════════════════════════════════════════════════════════

model Follow {
  id       String @id // flw_<ulid>
  userId   String @map("user_id")
  sellerId String @map("seller_id")

  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// ⚠️ Esta restricción es lo que hace confiable al contador denormalizado.
  ///
  /// `Seller.followersCount` se incrementa en la MISMA transacción que inserta
  /// la fila. Si dos peticiones concurrentes intentaran seguir al mismo
  /// vendedor, la segunda choca contra este índice y su transacción entera se
  /// deshace — incremento incluido.
  ///
  /// Sin la restricción, el contador se despegaría de la realidad y no habría
  /// forma de saber cuál de los dos números miente.
  @@unique([userId, sellerId])
  @@index([sellerId, createdAt])
  @@index([userId, createdAt])
  @@map("follows")
}

// ═══════════════════════════════════════════════════════════════════════════
// RESEÑAS
//
// ─── Una reseña necesita una compra ───
//
// `orderId` es único y obligatorio. No se puede reseñar sin haber comprado, y
// no se puede reseñar dos veces la misma compra.
//
// Es la defensa más efectiva contra reseñas falsas y no requiere moderación:
// para dejar una hay que haber pagado, y cada compra vale una sola. Un sistema
// abierto se llena de basura el primer mes y después hay que moderar a mano
// para siempre.
// ═══════════════════════════════════════════════════════════════════════════

model Review {
  id String @id // rev_<ulid>

  /// Una reseña por compra. La restricción está en la base, no en el código.
  orderId  String @unique @map("order_id")
  sellerId String @map("seller_id")
  authorId String @map("author_id")

  /// 1 a 5. El CHECK va en la migración: un rating de 47 no puede existir
  /// aunque el código tenga un bug.
  rating Int @db.SmallInt

  comment String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════════════════
// INTENCIÓN DE COMPRA
//
// ─── Por qué esto NO es una reserva ───
//
// Cuando la tienda está cerrada, quien quiere ese producto deja su intención.
// **No se descuenta stock.**
//
// Una `InventoryReservation` dura cinco minutos porque bloquea una unidad real:
// mientras existe, nadie más puede comprarla. Bloquear stock durante las diez
// horas que una tienda está cerrada sería sacar productos de la venta para
// gente que quizás no vuelva — y con varias intenciones sobre lo mismo, dejar
// el catálogo vacío sin haber vendido nada.
//
// Esto es una lista de espera. No promete nada y no compromete inventario.
// ═══════════════════════════════════════════════════════════════════════════

model PurchaseIntent {
  id               String @id // pin_<ulid>
  userId           String @map("user_id")
  productVariantId String @map("product_variant_id")

  quantity Int @default(1) @db.SmallInt

  /// Cuándo se le avisó que ya podía comprar. `null` = todavía no.
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  /// Una intención por persona y variante: tocar el botón dos veces no crea dos.
  @@unique([userId, productVariantId])
  @@index([productVariantId, notifiedAt])
  @@map("purchase_intents")
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICACIONES
//
// ─── Una fila por aviso, no un envío directo a FCM ───
//
// Cuando pasa algo que hay que avisar —una tienda que reabre, un pedido que
// se despachó, una respuesta de soporte— se escribe una fila acá. El envío del
// push es un paso APARTE, que lee estas filas.
//
// El motivo es que FCM se cae, tarda, y devuelve errores por token. Si el aviso
// se mandara desde adentro de la transacción que despacha el pedido:
//
//   · un timeout de Google revertiría el despacho, que ya pasó de verdad;
//   · o se ignoraría el error, y el aviso se perdería sin dejar rastro.
//
// Con la fila escrita, el peor caso es un aviso que llega tarde. Y queda el
// centro de notificaciones dentro de la app, que funciona aunque la persona
// tenga los push apagados —que es la mayoría— o el teléfono sin señal.
//
// ─── Por qué el estado del push vive en la misma fila ───
//
// Un aviso va a UNA persona; el reparto por dispositivo se resuelve mandando a
// todos sus tokens, y el estado por token ya vive en `Device.failureCount`.
// Una tabla aparte de "entregas" agregaría una unión por cada lectura del
// centro de notificaciones para responder algo que nadie pregunta.
// ═══════════════════════════════════════════════════════════════════════════

enum NotificationType {
  /// La tienda donde alguien dejó una intención volvió a abrir.
  STORE_REOPENED
  /// Un vendedor al que se sigue arrancó un vivo.
  LIVE_STARTED
  /// Cambió el estado de un pedido: preparándose, listo, despachado, entregado.
  ORDER_STATUS
  /// Al vendedor: le entró una venta.
  ORDER_RECEIVED
  /// Se acreditó un pago.
  PAYMENT_APPROVED
  /// Se rechazó un cobro y se puede reintentar.
  PAYMENT_REJECTED
  /// Hay novedades en un ticket de soporte.
  SUPPORT_REPLY
  /// Aviso de la plataforma: verificación, suspensión, cambios de cuenta.
  ACCOUNT
}

enum NotificationPushStatus {
  /// Todavía no se intentó mandar.
  PENDING
  /// Se entregó a FCM. No garantiza que haya llegado al teléfono.
  SENT
  /// No se intentó a propósito: sin dispositivos, o push apagados.
  SKIPPED
  /// Se intentó y falló las veces suficientes como para dejar de intentar.
  FAILED
}

model Notification {
  id     String @id // ntf_<ulid>
  userId String @map("user_id")

  type NotificationType

  /// El texto ya resuelto, no una plantilla con variables.
  ///
  /// Se guarda escrito porque tiene que decir lo mismo dentro de un año. Una
  /// plantilla renderizada al leer diría "Tu pedido de {producto}" con el
  /// nombre ACTUAL del producto, que el vendedor pudo haber cambiado, y para
  /// un producto archivado no diría nada.
  title String
  body  String

  /// A dónde lleva tocarla. `{ tipo: 'order', id: 'ord_...' }`.
  ///
  /// Json y no columnas: cada tipo de aviso apunta a una entidad distinta, y
  /// una columna por entidad serían ocho columnas nulas en cada fila.
  data Json?

  /// Idempotencia de negocio.
  ///
  /// `store_reopened:<storeId>:<userId>` hace que una tienda que abre y cierra
  /// tres veces en una tarde —porque el vendedor está probando el horario— no
  /// mande tres avisos a la misma persona. El índice único lo garantiza en la
  /// base, no en un `if` que se puede perder una carrera.
  dedupeKey String? @unique @map("dedupe_key")

  /// Cuándo la persona la vio dentro de la app. `null` = sin leer.
  readAt DateTime? @map("read_at")

  pushStatus    NotificationPushStatus @default(PENDING) @map("push_status")
  pushAttempts  Int                    @default(0) @map("push_attempts") @db.SmallInt
  /// Cuándo se puede volver a intentar. Espaciado creciente entre fallos.
  nextAttemptAt DateTime?              @map("next_attempt_at")
  pushedAt      DateTime?              @map("pushed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// El centro de notificaciones: las de esta persona, las más nuevas primero.
  @@index([userId, createdAt])
  /// El contador de no leídas, sin recorrer el historial entero.
  @@index([userId, readAt])
  /// El barrido de envío: sólo las que están esperando su turno.
  @@index([pushStatus, nextAttemptAt])
  @@map("notifications")
}

/// Qué ofrece el vendedor en cambios y devoluciones.
///
/// `SOLO_LEGAL` no significa "nada": significa exactamente lo que la ley
/// obliga, que ya es un derecho de arrepentimiento de diez días corridos.
enum ExchangeMode {
  SOLO_LEGAL
  CAMBIO_SIN_CAUSA
  DEVOLUCION_SIN_CAUSA
}

/// Quién paga el envío de la devolución.
enum ReturnShippingPayer {
  VENDEDOR
  COMPRADOR
}

// ═══════════════════════════════════════════════════════════════════════════
// OAUTH CON MERCADO PAGO
//
// ─── Por qué VendoX no cobra en su propia cuenta ───
//
// La plata de una venta es del VENDEDOR. Si entrara a una cuenta de VendoX y
// después se la girásemos, estaríamos operando como entidad de pago —con todo
// lo que eso implica legalmente— y con el dinero de terceros en nuestro
// balance.
//
// Con el modelo de marketplace de Mercado Pago, el cobro va directo a la
// cuenta del vendedor y Mercado Pago nos descuenta la comisión en el mismo
// movimiento. Nunca tocamos la plata de nadie.
//
// El precio es esta maquinaria: cada vendedor tiene que conectar su cuenta por
// OAuth, y hay que guardar sus tokens de forma que un volcado de la base no
// alcance para cobrar en su nombre.
// ═══════════════════════════════════════════════════════════════════════════

/// El `state` de una autorización OAuth en curso.
///
/// ═══════════════════════════════════════════════════════════════════════════
/// ES LA DEFENSA CONTRA QUE ALGUIEN CONECTE SU CUENTA A OTRO VENDEDOR
/// ═══════════════════════════════════════════════════════════════════════════
///
/// Sin `state`, el callback de OAuth acepta cualquier `code` que llegue. Un
/// atacante inicia la autorización con SU cuenta de Mercado Pago, se queda con
/// el `code`, y hace que la víctima —con su sesión de VendoX abierta— visite la
/// URL del callback. Resultado: la tienda de la víctima queda cobrando a la
/// cuenta del atacante, y cada venta que haga le deposita a él.
///
/// El `state` ata el callback a la petición que lo originó: se genera acá,
/// viaja a Mercado Pago y vuelve. Si no coincide con una fila viva de este
/// vendedor, el callback se rechaza.
///
/// ─── En la base y no en Redis ───
///
/// Es la misma regla del resto del proyecto: Redis es precisión, no una
/// dependencia. Con el `state` en Redis, un reinicio de Redis a mitad de una
/// autorización deja al vendedor con un error incomprensible en el navegador,
/// después de haber puesto su contraseña de Mercado Pago.
model OAuthState {
  id       String @id // oas_<ulid>
  sellerId String @map("seller_id")

  /// El valor que viaja a Mercado Pago y vuelve. Aleatorio de 32 bytes.
  ///
  /// Único a nivel global: dos vendedores no pueden compartirlo ni por
  /// casualidad, y el índice lo garantiza.
  state String @unique

  provider PaymentProvider @default(MERCADO_PAGO)

  /// Cuándo deja de valer. Diez minutos: es lo que tarda una persona en
  /// autorizar, y más tiempo sólo agranda la ventana de un ataque.
  expiresAt DateTime @map("expires_at")

  /// Cuándo se canjeó. Un `state` **se usa una sola vez**.
  ///
  /// Sin esto, alguien que capture la URL del callback —del historial del
  /// navegador, de un log de proxy— puede repetirla. No haría daño hoy, pero
  /// es exactamente la clase de suposición que deja de ser cierta cuando el
  /// callback empiece a hacer algo más.
  usedAt DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// El barrido que borra los vencidos.
  @@index([expiresAt])
  @@map("oauth_states")
}

/// Los tokens de Mercado Pago de un vendedor, cifrados.
///
/// ═══════════════════════════════════════════════════════════════════════════
/// TABLA APARTE DE `SellerPaymentAccount`. A PROPÓSITO.
/// ═══════════════════════════════════════════════════════════════════════════
///
/// `SellerPaymentAccount` se consulta todo el tiempo: para saber si el vendedor
/// puede cobrar, para pintar el estado en su panel, para filtrar los que no
/// conectaron. Nada de eso necesita el token.
///
/// Con los tokens en la misma tabla, cualquier `SELECT *` de cualquier consulta
/// de estado los trae a memoria y los mete en el registro de la consulta lenta,
/// en el volcado de depuración y en la respuesta de un endpoint al que alguien
/// se olvidó de ponerle proyección.
///
/// Separados, el camino para leerlos es uno solo y explícito.
///
/// ─── Cifrado con sobre ───
///
/// El texto cifrado vive acá; la llave vive en una variable de entorno del
/// proceso. Un volcado de la base, por sí solo, no sirve para nada.
///
/// No es tan bueno como un gestor de secretos con auditoría y rotación
/// automática —eso sigue siendo el destino— pero es muchísimo mejor que texto
/// plano, y no depende de contratar nada. Ver `shared/crypto/secretos.ts`.
model SellerOAuthCredential {
  id       String @id // soc_<ulid>
  sellerId String @map("seller_id")

  provider PaymentProvider @default(MERCADO_PAGO)

  /// El access token, cifrado con AES-256-GCM.
  accessCiphertext String @map("access_ciphertext")
  accessIv         String @map("access_iv")
  accessTag        String @map("access_tag")

  /// El refresh token, cifrado igual.
  ///
  /// Vale MÁS que el access token: con él se pueden generar tokens nuevos para
  /// siempre. Que esté en la misma fila no lo hace menos importante — se cifra
  /// con su propio IV, nunca compartido.
  refreshCiphertext String? @map("refresh_ciphertext")
  refreshIv         String? @map("refresh_iv")
  refreshTag        String? @map("refresh_tag")

  /// Con qué llave se cifró. Permite rotar sin descifrar todo de una vez.
  keyVersion Int @default(1) @map("key_version")

  /// Los últimos cuatro caracteres del access token, en claro.
  ///
  /// Para que soporte pueda confirmar "sí, es el que termina en a3f9" sin que
  /// el token completo aparezca en un ticket ni en una captura de pantalla.
  accessHint String? @map("access_hint")

  /// Cuándo vence el access token. Mercado Pago los da por seis meses.
  expiresAt DateTime? @map("expires_at")

  /// Cuándo se renovó por última vez, para poder ver si el refresco funciona.
  refreshedAt DateTime? @map("refreshed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Una credencial por vendedor y proveedor. Reconectar reemplaza, no acumula.
  @@unique([sellerId, provider])
  @@map("seller_oauth_credentials")
}

// ═══════════════════════════════════════════════════════════════════════════
// SOPORTE
//
// ─── Por qué hay IA y humanos, y no uno solo ───
//
// La mayoría de las consultas de un marketplace son las mismas diez preguntas:
// "dónde está mi pedido", "cómo cambio un talle", "por qué no me acreditaron".
// Contestarlas a mano, 24 horas, con un equipo de una persona, es imposible.
//
// Pero hay un grupo que NO puede contestar una máquina: todo lo que decide
// quién se queda con la plata. Una devolución, una disputa, un cobro duplicado.
// Ahí una respuesta equivocada no es una molestia: es dinero de alguien.
//
// Por eso el diseño no es "IA con humano de respaldo" sino "IA para lo que se
// puede automatizar y ESCALADA OBLIGATORIA para lo que no". La diferencia está
// en `SupportCategory`: hay categorías donde la IA no llega a opinar.
// ═══════════════════════════════════════════════════════════════════════════

enum SupportCategory {
  /// Dónde está mi pedido, cuándo llega, no me llegó.
  ENVIO
  /// Cómo cambio, cómo devuelvo, qué política tiene esta tienda.
  CAMBIOS
  /// ⚠️ No me acreditaron, me cobraron dos veces, quiero mi plata.
  PAGOS
  /// ⚠️ Tengo un problema con el vendedor / con el comprador.
  DISPUTA
  /// No puedo entrar, perdí el acceso, quiero borrar mi cuenta.
  CUENTA
  /// Cómo vendo, cómo hago un vivo, cómo cargo productos.
  VENDEDOR
  /// Algo está roto en la app.
  PROBLEMA_TECNICO
  /// Cualquier otra cosa.
  OTRO
}

enum SupportStatus {
  /// Esperando una respuesta nuestra.
  ABIERTO
  /// Contestamos y esperamos a la persona.
  ESPERANDO_RESPUESTA
  /// La IA no puede o no debe: espera a una persona del equipo.
  ESCALADO
  /// Resuelto. Se puede reabrir contestando.
  RESUELTO
  /// Cerrado sin actividad. No se reabre: se crea uno nuevo.
  CERRADO
}

enum SupportAuthor {
  /// Quien abrió el ticket.
  USUARIO
  /// El asistente automático.
  ASISTENTE
  /// Una persona del equipo.
  EQUIPO
  /// Mensajes del sistema: "escalado a una persona", "cerrado por inactividad".
  SISTEMA
}

model SupportTicket {
  id     String @id // sup_<ulid>
  userId String @map("user_id")

  category SupportCategory @default(OTRO)
  status   SupportStatus   @default(ABIERTO)

  /// Lo que la persona escribió al abrirlo, recortado. Para la lista.
  subject String

  /// El pedido del que habla, si habla de uno.
  ///
  /// Sin relación de base a propósito: un ticket sobre un pedido tiene que
  /// sobrevivir a que ese pedido se borre. Es el registro de una conversación,
  /// no un dato derivado.
  orderId String? @map("order_id")

  /// Si una persona del equipo ya lo miró. `null` = nadie todavía.
  assignedToUserId String? @map("assigned_to_user_id")

  /// Por qué se escaló. Lo escribe el sistema, no la persona.
  escalationReason String? @map("escalation_reason")
  escalatedAt      DateTime? @map("escalated_at")

  /// Para ordenar la bandeja por lo que hace más que esperar.
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  resolvedAt    DateTime? @map("resolved_at")
  closedAt      DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  /// Los tickets de una persona, los más recientes primero.
  @@index([userId, lastMessageAt])
  /// La bandeja del equipo: lo escalado primero, lo más viejo arriba.
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String @id // sms_<ulid>
  ticketId String @map("ticket_id")

  author SupportAuthor
  body   String

  /// Quién lo escribió, cuando fue una persona. `null` para IA y sistema.
  authorUserId String? @map("author_user_id")

  /// Si el asistente decidió escalar en este mensaje.
  ///
  /// Se guarda en el mensaje y no sólo en el ticket porque una conversación
  /// puede escalar, resolverse y volver a escalar. El ticket dice el estado de
  /// AHORA; esto dice qué pasó en cada paso.
  escalated Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// ME GUSTA
//
// ─── Por qué una tabla polimórfica y no una por tipo ───
//
// Se puede dar "me gusta" a un vivo y a un producto, y mañana a una reseña.
// Tres tablas idénticas con un nombre distinto significan tres consultas
// distintas para "qué le gustó a esta persona", tres contadores que mantener y
// tres formas de escribir el mismo bug.
//
// El costo de la tabla polimórfica es que la base no puede garantizar que
// `targetId` apunte a algo que existe: no hay clave foránea posible cuando el
// destino cambia de tabla según una columna. Se acepta a conciencia — un "me
// gusta" huérfano no rompe nada, y el barrido que limpia se puede escribir
// cuando haga falta.
// ═══════════════════════════════════════════════════════════════════════════

enum LikeTarget {
  LIVE
  PRODUCT
}

model Like {
  id     String @id // lik_<ulid>
  userId String @map("user_id")

  targetType LikeTarget @map("target_type")
  targetId   String     @map("target_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Uno por persona y cosa. Tocar dos veces no cuenta dos.
  ///
  /// El índice único es lo que lo garantiza, no un `if`: dos toques rápidos
  /// —que en un vivo pasan todo el tiempo— llegan como dos peticiones
  /// simultáneas y una comprobación previa perdería la carrera.
  @@unique([userId, targetType, targetId])
  /// "¿Le gusta a esta persona?", que se pregunta al pintar cada tarjeta.
  @@index([targetType, targetId])
  @@map("likes")
}
