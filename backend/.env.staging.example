# =============================================================================
# VendoX — variables de staging
#
# ⚠️ SÓLO NOMBRES Y MARCADORES. Ningún valor real acá adentro, nunca.
#
# Este archivo se commitea. Los valores reales viven en el gestor de secretos
# del proveedor de compute:
#
#   · IBM Code Engine → ibmcloud ce secret create
#   · Fly.io          → fly secrets set
#   · Render          → Environment → Secret Files / Environment Variables
#
# La aplicación no lee ningún `.env` en la nube: las variables vienen
# inyectadas en el entorno del proceso.
# =============================================================================

# ─── Plataforma ──────────────────────────────────────────────────────────────

NODE_ENV=staging

# Dónde corre el contenedor. Decide de qué cabecera sale la IP del cliente.
#   fly | render | ibm_code_engine
#
# Se DECLARA y no se detecta: deducirlo de las cabeceras significaría confiar
# en algo que, fuera de ese proveedor, escribe cualquiera.
DEPLOYMENT_PROVIDER=

# Lo inyecta la plataforma; NO lo pongas a mano salvo que sepas que no lo hace.
#   · Code Engine → 8080 (lo inyecta solo)
#   · Fly         → el de fly.toml
#   · Render      → lo inyecta solo
PORT=

# Cuántos proxies hay delante.
#   1 = el proxy del proveedor
#   2 = un CDN propio (Cloudflare) delante de ese proxy
#
# ⚠️ Con 0 detrás de un proxy, todo el tráfico comparte un solo contador de
# límite de peticiones y una persona deja afuera a las demás. Con un número
# más alto del real, se vuelve a confiar en lo que mandó el cliente.
TRUSTED_PROXY_HOPS=1

# Qué hace este proceso: all | web | worker
#   all    → API + tareas periódicas (un contenedor)
#   web    → sólo API (usar cuando hay worker o tarea programada aparte)
#   worker → sólo tareas periódicas, sin puerto abierto
APP_ROLE=web

# Presupuesto de apagado. Ajustar al plazo que da cada plataforma antes del
# SIGKILL: Fly da 30 s; Code Engine y Render, menos.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

LOG_LEVEL=info

# ─── PostgreSQL (Neon, São Paulo) ────────────────────────────────────────────

# La del POOLER — el host lleva `-pooler`. La usa la aplicación.
# Tiene que llevar `pgbouncer=true`: sin eso Prisma usa prepared statements que
# PgBouncer no sostiene en modo transacción, y fallan de forma intermitente con
# `prepared statement "s0" already exists`.
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.sa-east-1.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=5

# La DIRECTA — el host NO lleva `-pooler`. La usan sólo las migraciones.
# `migrate deploy` toma un lock de sesión; contra el pooler se cuelga o deja la
# migración a medio aplicar.
DIRECT_URL=postgresql://USER:PASS@HOST.sa-east-1.aws.neon.tech/DB?sslmode=require

# ─── Redis (Upstash, São Paulo) ──────────────────────────────────────────────

# ⚠️ `rediss://` con DOS eses. La variante de una sola manda el token en texto
# plano por internet abierto — y funciona igual, sin error ni aviso.
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# ─── Autenticación ───────────────────────────────────────────────────────────

# openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000
JWT_ISSUER=vendox
JWT_AUDIENCE=vendox-app

GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
APPLE_BUNDLE_ID=

# Emite sesiones válidas sin verificar nada contra ningún proveedor.
# En producción el esquema lo prohíbe. En staging, sólo mientras no haya
# credenciales de Google configuradas.
AUTH_DEV_LOGIN_ENABLED=false

# ─── LiveKit ─────────────────────────────────────────────────────────────────

LIVEKIT_API_KEY=
# Firma los tokens. Nunca sale del backend, jamás llega a Flutter.
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://PROYECTO.livekit.cloud
LIVEKIT_HTTP_URL=https://PROYECTO.livekit.cloud

# ─── Mercado Pago ────────────────────────────────────────────────────────────

# ⚠️ Credenciales de PRUEBA. Empiezan con `TEST-`.
# El backend rechaza arrancar fuera de producción con un token productivo: es
# la salvaguarda contra cobrarle de verdad a alguien durante una prueba.
MP_ACCESS_TOKEN=TEST-
MP_PUBLIC_KEY=TEST-
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://TU-DOMINIO/webhooks/mercadopago

# ─── Observabilidad ──────────────────────────────────────────────────────────

# URL pública tal como la ve un teléfono. Se usa para armar los enlaces de las
# imágenes; no se puede deducir de la petición porque detrás del proxy el host
# que ve el servidor no es el que el cliente puede volver a pedir.
PUBLIC_BASE_URL=https://TU-DOMINIO

# openssl rand -hex 32
# Obligatoria fuera de local: /metrics expone volumen de ventas, tasa de
# rechazo de pagos y el mapa completo de rutas.
METRICS_TOKEN=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Interruptores ───────────────────────────────────────────────────────────

# Los spikes NO tienen autenticación de usuarios. Jamás encendidos.
SPIKE_ENABLED=false
PAYMENTS_SPIKE_ENABLED=false

# Las tareas periódicas. Se dejan en true acá y es `APP_ROLE` quien decide en
# qué proceso corren.
INVENTORY_RECONCILER_ENABLED=true
ORDERS_RECONCILER_ENABLED=true
INVENTORY_EXPIRATION_QUEUE_ENABLED=true
