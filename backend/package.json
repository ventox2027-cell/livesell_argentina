{
  "name": "@livesell/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Live Shopping Argentina — API (monolito modular NestJS + Fastify)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "lint:fix": "eslint src test scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test:db:create": "docker exec livesell-postgres psql -U livesell -d postgres -c \"CREATE DATABASE livesell_test OWNER livesell;\"",
    "test:db:migrate": "tsx scripts/migrate-test-db.ts",
    "spike:report": "tsx scripts/spike-report.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-fastify": "11.1.29",
    "@prisma/client": "6.19.3",
    "dotenv": "17.4.2",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "jose": "^6.2.8",
    "livekit-server-sdk": "2.17.0",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "2.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.47",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "unplugin-swc": "1.5.10",
    "vitest": "2.1.9"
  }
}
